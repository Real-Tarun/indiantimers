---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={`Page Not Found (404) | ${siteConfig.name}`}
  description="The requested examination schedule or timer page could not be located. Explore our master directory of upcoming 2027 Indian competitive exams."
  robots="noindex, follow"
>
  <div class="text-center py-16 sm:py-24 max-w-xl mx-auto">
    <div class="w-16 h-16 rounded-2xl bg-blue-100 dark:bg-blue-950 flex items-center justify-center mx-auto mb-4 text-blue-600 dark:text-blue-400 font-black text-2xl">
      404
    </div>

    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 mb-3">
      Examination Schedule Not Found
    </h1>

    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-8">
      The page you are looking for might have been renamed, rescheduled, or does not exist. Use our master directory to find verified countdowns for all major Indian examinations.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl text-xs font-bold bg-blue-600 text-white hover:bg-blue-700 transition-colors shadow-xs"
      >
        Return to Home
      </a>
      <a
        href="/exams/"
        class="px-5 py-2.5 rounded-xl text-xs font-semibold border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors"
      >
        Browse Exam Directory
      </a>
      <a
        href="/calendar/2027/"
        class="px-5 py-2.5 rounded-xl text-xs font-semibold border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors"
      >
        2027 Master Calendar
      </a>
    </div>
  </div>
</BaseLayout>
