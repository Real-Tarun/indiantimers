---
import BaseLayout from '../layouts/BaseLayout.astro';
import CountdownCard from '../components/CountdownCard';
import { EXAM_REGISTRY } from '../data/exams';
import { siteConfig } from '../config/site';

// Featured upcoming exams for instant hero grid
const featuredExams = EXAM_REGISTRY.filter((e) => e.isFeatured).slice(0, 6);

// Structured data for WebSite with potential SearchAction
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteConfig.url}/exams/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title={`${siteConfig.name} - India's Premier Exam Countdown & Student Focus Suite`}
  description="Accurate countdowns, verified official schedules, and distraction-free study timers for NEET, JEE Main, UPSC, GATE, CBSE Board, and Indian competitive exams."
  schema={websiteSchema}
>
  {/* Hero Section: Compact, Tool-first, Non-bloated */}
  <section class="mb-10 text-center max-w-3xl mx-auto pt-2 sm:pt-4">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200/80 dark:border-blue-900 mb-4">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Official 2027 Schedules Audited & Live</span>
    </div>

    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-slate-50 leading-tight mb-4">
      India's Premier <span class="text-blue-600 dark:text-blue-400">Exam Countdown</span> & Focus Suite
    </h1>

    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
      Verified countdowns backed by official circulars from NTA, UPSC, IITs, and CBSE. Zero speculative dates. Built-in Pomodoro, mock test pacing, and personal deadline tracking.
    </p>

    {/* Quick Action Navigation Buttons */}
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/exams/"
        class="px-5 py-2.5 rounded-xl text-xs font-bold bg-blue-600 text-white hover:bg-blue-700 shadow-xs transition-colors"
      >
        Explore All 50+ Exams
      </a>
      <a
        href="/calendar/2027/"
        class="px-5 py-2.5 rounded-xl text-xs font-semibold border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors"
      >
        2027 Master Calendar
      </a>
      <a
        href="/tools/pomodoro-timer/"
        class="px-5 py-2.5 rounded-xl text-xs font-semibold border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors"
      >
        Focus Timer
      </a>
      <a
        href="/tools/mock-test-timer/"
        class="px-5 py-2.5 rounded-xl text-xs font-semibold border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors"
      >
        Mock Test Simulator
      </a>
    </div>
  </section>

  {/* High Priority Upcoming Exam Countdowns */}
  <section class="mb-14">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">
          Featured Examination Countdowns
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Audited dates for major 2026-2027 national entrance and board examinations.
        </p>
      </div>
      <a
        href="/exams/"
        class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline"
      >
        View All Exams →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {featuredExams.map((exam) => (
        <CountdownCard client:load exam={exam} />
      ))}
    </div>
  </section>

  {/* Category Directory Cards */}
  <section class="mb-14">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">
        Browse by Examination Discipline
      </h2>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Dedicated schedule hubs with official announcements and syllabus timelines.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {siteConfig.categories.map((cat) => (
        <a
          href={`/exams/${cat.slug}/`}
          class="group p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 hover:border-blue-500 dark:hover:border-blue-500/60 hover:shadow-sm transition-all"
        >
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {cat.name}
            </h3>
            <span class="text-xs text-blue-600 dark:text-blue-400 font-semibold group-hover:translate-x-1 transition-transform">
              →
            </span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            {cat.description}
          </p>
        </a>
      ))}
    </div>
  </section>

  {/* Interactive Study Tools Suite Promo */}
  <section class="mb-14 rounded-2xl border border-slate-200 dark:border-slate-800 bg-gradient-to-r from-blue-50/70 via-slate-50 to-indigo-50/70 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800/80 p-6 sm:p-8">
    <div class="max-w-2xl mb-6">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
        Student Focus Tools
      </span>
      <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mt-1 mb-2">
        Integrated Preparation Tools for Indian Aspirants
      </h2>
      <p class="text-xs text-slate-600 dark:text-slate-300">
        Beyond countdowns: measure your speed, practice official 3-hour exam mocks, and maintain disciplined Pomodoro study cycles with synthesized audio cues.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <a
        href="/tools/pomodoro-timer/"
        class="p-4 rounded-xl bg-white dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700 shadow-xs hover:border-blue-400 transition-all"
      >
        <span class="text-sm font-bold text-slate-900 dark:text-slate-100 block mb-1">
          Pomodoro Focus
        </span>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">
          25/5 and 50/10 intervals with wake lock and study session logging.
        </p>
      </a>

      <a
        href="/tools/mock-test-timer/"
        class="p-4 rounded-xl bg-white dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700 shadow-xs hover:border-blue-400 transition-all"
      >
        <span class="text-sm font-bold text-slate-900 dark:text-slate-100 block mb-1">
          Mock Test Simulator
        </span>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">
          NEET 200m, JEE 180m, UPSC 120m presets with questions-per-minute pacing.
        </p>
      </a>

      <a
        href="/tools/stopwatch/"
        class="p-4 rounded-xl bg-white dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700 shadow-xs hover:border-blue-400 transition-all"
      >
        <span class="text-sm font-bold text-slate-900 dark:text-slate-100 block mb-1">
          Precision Stopwatch
        </span>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">
          Lap split times and keyboard shortcut support for speed drills.
        </p>
      </a>

      <a
        href="/tools/countdown/"
        class="p-4 rounded-xl bg-white dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700 shadow-xs hover:border-blue-400 transition-all"
      >
        <span class="text-sm font-bold text-slate-900 dark:text-slate-100 block mb-1">
          Custom Deadlines
        </span>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">
          Personal timers for coaching tests, assignments, and application cutoffs.
        </p>
      </a>
    </div>
  </section>

  {/* Researched Guides & Articles Preview */}
  <section class="mb-14">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">
          Editorial Preparation & Schedule Guides
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Fact-checked guides on exam notification cycles, calendar analysis, and study pacing.
        </p>
      </div>
      <a href="/blog/" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
        All Guides →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <article class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider">Exam Analysis</span>
          <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mt-1 mb-2">
            <a href="/blog/exam-calendar-2027-india/" class="hover:underline">
              Indian Examination Calendar 2027: Official vs Tentative Dates
            </a>
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            A comprehensive audit of national entrance schedules, explaining how conducting bodies determine testing windows.
          </p>
        </div>
        <div class="pt-3 mt-4 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
          <span>7 min read</span>
          <a href="/blog/exam-calendar-2027-india/" class="font-semibold text-blue-600 hover:underline">Read →</a>
        </div>
      </article>

      <article class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider">Strategy</span>
          <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mt-1 mb-2">
            <a href="/blog/pomodoro-technique-for-competitive-exams/" class="hover:underline">
              Using the Pomodoro Technique for NEET & JEE Preparation
            </a>
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Adapting the standard 25-minute loop into 50-minute blocks to match the stamina required for 3-hour competitive papers.
          </p>
        </div>
        <div class="pt-3 mt-4 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
          <span>6 min read</span>
          <a href="/blog/pomodoro-technique-for-competitive-exams/" class="font-semibold text-blue-600 hover:underline">Read →</a>
        </div>
      </article>

      <article class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-bold text-purple-600 uppercase tracking-wider">Planning</span>
          <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mt-1 mb-2">
            <a href="/blog/how-to-plan-study-time-around-exam-countdown/" class="hover:underline">
              Reverse Timeline Planning: Building Schedules from Countdowns
            </a>
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            How to divide remaining countdown days into syllabus completion, revision cycles, and full-length mock simulations.
          </p>
        </div>
        <div class="pt-3 mt-4 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
          <span>8 min read</span>
          <a href="/blog/how-to-plan-study-time-around-exam-countdown/" class="font-semibold text-blue-600 hover:underline">Read →</a>
        </div>
      </article>
    </div>
  </section>

  {/* Compact FAQ Section */}
  <section class="max-w-3xl mx-auto mb-10">
    <div class="text-center mb-6">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">
        Frequently Asked Questions
      </h2>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Direct answers regarding our schedule provenance and timer tools.
      </p>
    </div>

    <div class="space-y-3">
      <div class="rounded-xl border border-slate-200 dark:border-slate-800 p-4 bg-white dark:bg-slate-900">
        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-1">
          How does IndianTimers verify examination dates?
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Every date is audited against official circulars published by conducting bodies such as NTA, UPSC, IIT Joint Admission Boards, and CBSE. We explicitly distinguish between Official Confirmed dates, Tentative calendar dates, and unannounced dates. We never manufacture speculative countdowns.
        </p>
      </div>

      <div class="rounded-xl border border-slate-200 dark:border-slate-800 p-4 bg-white dark:bg-slate-900">
        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-1">
          Are my saved countdowns and study sessions private?
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Yes. All personal favorites, custom deadlines, and study session records are stored 100% locally on your device using browser LocalStorage. No account or mobile number is required, and you can export or wipe your data anytime.
        </p>
      </div>

      <div class="rounded-xl border border-slate-200 dark:border-slate-800 p-4 bg-white dark:bg-slate-900">
        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-1">
          Can I export examination dates to Google Calendar or Apple Calendar?
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Yes. Every exam detail page and countdown card offers a one-click downloadable standard RFC 5545 .ICS file and direct Google Calendar import links.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
