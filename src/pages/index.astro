---
import BaseLayout from '../layouts/BaseLayout.astro';
import CountdownCard from '../components/CountdownCard';
import { DIRECTORY_EXAMS } from '../data/exams';
import { siteConfig } from '../config/site';

// Featured upcoming exams for hero grid
const featuredExams = DIRECTORY_EXAMS.filter((e) => e.isFeatured).slice(0, 6);

// Structured data
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteConfig.url}/exams/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const catMeta: Record<string, { emoji: string; iconSrc?: string; color: string; bg: string }> = {
  medical:     { emoji: '💉', iconSrc: '/icons/categories/medical.png', color: '#E11D48', bg: '#FFF1F2' },
  engineering: { emoji: '⚙️', iconSrc: '/icons/categories/engineering.png', color: '#4338CA', bg: '#EEF2FF' },
  'board-exams':{ emoji: '📚', iconSrc: '/icons/categories/board-exams.png', color: '#047857', bg: '#ECFDF5' },
  government:  { emoji: '🏛️', color: '#C2410C', bg: '#FFF7ED' },
  law:         { emoji: '⚖️', iconSrc: '/icons/categories/law.png', color: '#6D28D9', bg: '#F5F3FF' },
  management:  { emoji: '💼', color: '#B45309', bg: '#FFFBEB' },
  'other-entrance-exams': { emoji: '✨', color: '#0E7490', bg: '#ECFEFF' },
};
---

<BaseLayout
  title={`${siteConfig.name} - India's Premier Exam Countdown & Student Focus Suite`}
  description="Accurate countdowns, verified official schedules, and distraction-free study timers for NEET, JEE Main, UPSC, GATE, CBSE Board, and Indian competitive exams."
  canonicalUrl={`${siteConfig.url}/`}
  schema={websiteSchema}
>

  <!-- ═══════════════════════════════════════════════════════════════════════
       HERO SECTION (FLUX BENTO AESTHETIC)
  ══════════════════════════════════════════════════════════════════════════ -->
  <section class="relative text-center pt-6 pb-12 sm:pb-16 mb-4">
    <!-- Live status pill -->
    <div class="inline-flex items-center gap-2 bg-[#18181B] text-white dark:bg-white dark:text-[#111406] px-4 py-1.5 rounded-full text-[11px] font-bold mb-6 shadow-xs animate-fade-in-up">
      <span class="w-2 h-2 rounded-full bg-[#D4FF4F] animate-pulse"></span>
      <span class="tracking-wide">2026–27 Schedules — Live & Officially Verified</span>
    </div>

    <!-- Hero headline -->
    <h1 class="font-display font-black text-slate-900 dark:text-white text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.1] mb-5 max-w-4xl mx-auto animate-fade-in-up anim-delay-1">
      India's Most Trusted
      <span class="block mt-2">
        <span class="inline-block px-4 py-1 rounded-2xl bg-[#D4FF4F] text-[#111406] shadow-xs transform -rotate-1">
          Live Exam Countdown
        </span>
      </span>
    </h1>

    <!-- Sub-headline -->
    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed animate-fade-in-up anim-delay-2">
      Precise countdowns verified against official circulars from NTA, UPSC, IITs, and CBSE.
      Zero speculative dates. Built-in Pomodoro, mock pacing, and personal deadline tracking.
    </p>

    <!-- Flux Pill Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3 animate-fade-in-up anim-delay-3">
      <a href="/exams/" class="btn-primary">
        <svg class="w-4 h-4 text-[#D4FF4F] dark:text-[#111406]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        Explore 50+ Exams
      </a>
      <a href="/calendar/2027/" class="btn-lime">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        2027 Master Calendar
      </a>
      <a href="/tools/pomodoro-timer/" class="btn-ghost">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/>
        </svg>
        Focus Timer
      </a>
    </div>

    <!-- Flux Stat Badges -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl mx-auto mt-10 animate-fade-in-up anim-delay-4">
      {[
        { value: '50+', label: 'Exams Tracked' },
        { value: '100%', label: 'Official Circulars' },
        { value: 'Live', label: 'Synced Countdown' },
        { value: 'Free', label: 'No Signup Needed' },
      ].map((stat) => (
        <div class="bg-white dark:bg-[#171923] border border-black/[0.05] dark:border-white/[0.08] rounded-2xl py-3 px-4 shadow-xs text-center">
          <div class="font-display font-extrabold text-xl sm:text-2xl text-slate-900 dark:text-white leading-none mb-1">
            {stat.value}
          </div>
          <div class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       FEATURED COUNTDOWN GRID
  ══════════════════════════════════════════════════════════════════════════ -->
  <section class="mb-16">
    <div class="flex items-end justify-between mb-7">
      <div>
        <div class="section-eyebrow">
          <span class="w-2 h-2 rounded-full bg-[#D4FF4F]"></span>
          <span>Live Examination Timers</span>
        </div>
        <h2 class="section-title">Upcoming National Exam Countdowns</h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Audited dates for major 2026–27 national entrance and board examinations.
        </p>
      </div>
      <a
        href="/exams/"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-[#D4FF4F] transition-colors shrink-0"
      >
        <span>View all 50+</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Category Stream Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-5 no-scrollbar" aria-label="Exam Streams">
      <a
        href="/exams/"
        class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap bg-[#18181B] dark:bg-white text-white dark:text-[#111406] shadow-xs flex items-center gap-1.5 transition-transform hover:scale-105"
      >
        <span>🎯</span>
        <span>All Exams</span>
      </a>
      <a
        href="/exams/engineering/"
        class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap bg-white dark:bg-[#171923] border border-black/[0.08] dark:border-white/[0.1] text-slate-700 dark:text-slate-200 hover:border-black/20 dark:hover:border-white/30 shadow-xs flex items-center gap-2 transition-transform hover:scale-105"
      >
        <img src="/icons/categories/engineering.png" alt="Engineering" class="w-4 h-4 object-contain inline-block" />
        <span>Engineering</span>
      </a>
      <a
        href="/exams/medical/"
        class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap bg-white dark:bg-[#171923] border border-black/[0.08] dark:border-white/[0.1] text-slate-700 dark:text-slate-200 hover:border-black/20 dark:hover:border-white/30 shadow-xs flex items-center gap-2 transition-transform hover:scale-105"
      >
        <img src="/icons/categories/medical.png" alt="Medical" class="w-4 h-4 object-contain inline-block" />
        <span>Medical</span>
      </a>
      <a
        href="/exams/government/"
        class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap bg-white dark:bg-[#171923] border border-black/[0.08] dark:border-white/[0.1] text-slate-700 dark:text-slate-200 hover:border-black/20 dark:hover:border-white/30 shadow-xs flex items-center gap-2 transition-transform hover:scale-105"
      >
        <span>🏛️</span>
        <span>Govt & UPSC</span>
      </a>
      <a
        href="/exams/board-exams/"
        class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap bg-white dark:bg-[#171923] border border-black/[0.08] dark:border-white/[0.1] text-slate-700 dark:text-slate-200 hover:border-black/20 dark:hover:border-white/30 shadow-xs flex items-center gap-2 transition-transform hover:scale-105"
      >
        <img src="/icons/categories/board-exams.png" alt="Board Exams" class="w-4 h-4 object-contain inline-block" />
        <span>Board Exams</span>
      </a>
      <a
        href="/exams/law/"
        class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap bg-white dark:bg-[#171923] border border-black/[0.08] dark:border-white/[0.1] text-slate-700 dark:text-slate-200 hover:border-black/20 dark:hover:border-white/30 shadow-xs flex items-center gap-2 transition-transform hover:scale-105"
      >
        <img src="/icons/categories/law.png" alt="Law" class="w-4 h-4 object-contain inline-block" />
        <span>Law (CLAT)</span>
      </a>
      <a
        href="/exams/management/"
        class="px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap bg-white dark:bg-[#171923] border border-black/[0.08] dark:border-white/[0.1] text-slate-700 dark:text-slate-200 hover:border-black/20 dark:hover:border-white/30 shadow-xs flex items-center gap-2 transition-transform hover:scale-105"
      >
        <span>💼</span>
        <span>Management</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {featuredExams.map((exam, i) => (
        <div class={`animate-fade-in-up anim-delay-${Math.min(i + 1, 6)}`}>
          <CountdownCard client:load exam={exam} />
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       CATEGORY DIRECTORY (FLUX BENTO CARDS)
  ══════════════════════════════════════════════════════════════════════════ -->
  <section class="mb-16">
    <div class="mb-7">
      <div class="section-eyebrow">
        <span class="w-2 h-2 rounded-full bg-[#D4FF4F]"></span>
        <span>Browse by Stream</span>
      </div>
      <h2 class="section-title">Examination Categories</h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
        Dedicated schedule hubs with official announcements and syllabus timelines.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {siteConfig.categories.map((cat, i) => {
        const meta = catMeta[cat.id] ?? catMeta['other-entrance-exams'];
        return (
          <a
            href={`/exams/${cat.slug}/`}
            class={`card group p-5 bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] rounded-[22px] hover:-translate-y-1 transition-all duration-200 animate-fade-in-up anim-delay-${Math.min(i + 1, 6)}`}
          >
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-xl mb-3 shadow-xs bg-[#F6F7FB] dark:bg-slate-800 border border-black/[0.04] dark:border-white/[0.05]">
              {meta.iconSrc ? (
                <img src={meta.iconSrc} alt={cat.name} class="w-6 h-6 object-contain" />
              ) : (
                <span>{meta.emoji}</span>
              )}
            </div>

            <h3 class="font-display font-bold text-[15px] text-slate-900 dark:text-white mb-1">
              {cat.name}
            </h3>
            <p class="text-[12px] text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-2">
              {cat.description}
            </p>

            <div class="flex items-center gap-1 mt-4 text-[12px] font-bold text-slate-900 dark:text-[#D4FF4F] group-hover:gap-2 transition-all">
              <span>View Timers</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       FLUX-STYLE DARK ACCENT BANNER (FOCUS TOOLS SUITE)
  ══════════════════════════════════════════════════════════════════════════ -->
  <section class="mb-16 relative overflow-hidden rounded-[26px] p-8 sm:p-10 bg-[#18181B] text-white shadow-xl">
    <div class="relative grid md:grid-cols-2 gap-8 items-center z-10">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[11px] font-black uppercase tracking-wider mb-4 bg-white/10 text-[#D4FF4F] border border-white/15">
          <span class="w-1.5 h-1.5 rounded-full bg-[#D4FF4F] animate-pulse"></span>
          Student Focus Suite
        </div>
        <h2 class="font-display font-black text-2xl sm:text-3xl lg:text-4xl leading-tight mb-3 tracking-tight">
          Tools Built for High-Stakes Indian Exams
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 max-w-md">
          Beyond countdowns: Pomodoro intervals, official mock pacing with question-per-minute tracking,
          and personal deadline management with local device storage.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/tools/pomodoro-timer/" class="btn-lime">
            Start Focus Session
          </a>
          <a href="/tools/mock-test-timer/" class="btn-ghost bg-white/10 text-white border-white/20 hover:bg-white/20">
            Mock Test Timer
          </a>
        </div>
      </div>

      <!-- Bento tool cards -->
      <div class="grid grid-cols-2 gap-3">
        {[
          { href: '/tools/pomodoro-timer/', icon: '⏱️', title: 'Pomodoro Focus', desc: '25/5 & 50/10 intervals with wake lock' },
          { href: '/tools/mock-test-timer/', icon: '📝', title: 'Mock Test Simulator', desc: 'NEET 200m, JEE 180m presets' },
          { href: '/tools/stopwatch/', icon: '🏁', title: 'Lap Stopwatch', desc: 'Precision splits for question speed drills' },
          { href: '/tools/countdown/', icon: '🎯', title: 'Custom Deadlines', desc: 'Private local timers for mock tests' },
        ].map((tool) => (
          <a
            href={tool.href}
            class="p-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 transition-all hover:-translate-y-0.5 group"
          >
            <div class="text-2xl mb-2">{tool.icon}</div>
            <div class="font-bold text-[13px] text-white group-hover:text-[#D4FF4F] transition-colors mb-1">{tool.title}</div>
            <div class="text-[11px] text-slate-400 leading-relaxed">{tool.desc}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       EDITORIAL GUIDES
  ══════════════════════════════════════════════════════════════════════════ -->
  <section class="mb-16">
    <div class="flex items-end justify-between mb-7">
      <div>
        <div class="section-eyebrow">
          <span class="w-2 h-2 rounded-full bg-[#D4FF4F]"></span>
          <span>Editorial Hub</span>
        </div>
        <h2 class="section-title">Preparation & Schedule Guides</h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Fact-checked guides on exam cycles, calendar analysis, and study pacing strategies.
        </p>
      </div>
      <a href="/blog/" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-[#D4FF4F] transition-colors shrink-0">
        <span>All Guides</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {[
        {
          tag: 'Exam Analysis',
          href: '/blog/exam-calendar-2027-india/',
          title: 'Indian Examination Calendar 2027: Official vs Tentative Dates',
          excerpt: 'A comprehensive audit of national entrance schedules, explaining how conducting bodies determine testing windows.',
          readTime: '7 min read',
        },
        {
          tag: 'Strategy',
          href: '/blog/pomodoro-technique-for-competitive-exams/',
          title: 'Pomodoro for NEET & JEE: Adapting the 25-Minute Loop',
          excerpt: 'Adapting the standard interval into 50-minute blocks to match the stamina required for 3-hour competitive papers.',
          readTime: '6 min read',
        },
        {
          tag: 'Planning',
          href: '/blog/how-to-plan-study-time-around-exam-countdown/',
          title: 'Reverse Timeline Planning: Schedules from Countdowns',
          excerpt: 'How to divide remaining countdown days into syllabus completion, revision cycles, and full-length mock simulations.',
          readTime: '8 min read',
        },
      ].map((article) => (
        <article class="card p-6 bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] rounded-[22px] flex flex-col justify-between hover:-translate-y-1 transition-all duration-200">
          <div>
            <span class="inline-flex px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 mb-3">
              {article.tag}
            </span>
            <h3 class="font-display font-bold text-[15px] text-slate-900 dark:text-white leading-snug mb-2">
              <a href={article.href} class="hover:underline underline-offset-2">{article.title}</a>
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{article.excerpt}</p>
          </div>
          <div class="flex items-center justify-between mt-5 pt-3 border-t border-black/[0.05] dark:border-white/[0.05]">
            <span class="text-[11px] font-semibold text-slate-400">{article.readTime}</span>
            <a href={article.href} class="text-[12px] font-bold text-slate-900 dark:text-[#D4FF4F] hover:underline flex items-center gap-1">
              Read Guide →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       COMPREHENSIVE EDITORIAL GUIDE TO INDIAN EXAM ECOSYSTEM
  ══════════════════════════════════════════════════════════════════════════ -->
  <section class="mb-16 pt-10 border-t border-black/[0.06] dark:border-white/[0.08] text-slate-700 dark:text-slate-300">
    <div class="max-w-4xl mx-auto space-y-10">
      <div class="text-center">
        <div class="section-eyebrow justify-center">
          <span class="w-2 h-2 rounded-full bg-[#D4FF4F]"></span>
          <span>Aspirant Knowledge Base</span>
        </div>
        <h2 class="section-title">Comprehensive Guide to India's Competitive Examination Ecosystem</h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 max-w-2xl mx-auto leading-relaxed">
          From national testing boards to state civil commissions, understanding testing cycles, admit card protocols, and syllabus timelines is crucial for high-stakes preparation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm">
        <div class="p-6 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
          <h3 class="font-display font-bold text-base text-slate-900 dark:text-white mb-2">
            Primary Conducting Authorities & Mandates
          </h3>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
            National testing across India is coordinated by specialized statutory and autonomous authorities. The <strong>National Testing Agency (NTA)</strong> administers major national gateways including NEET (UG), JEE Main, CUET, and UGC NET. The <strong>Union Public Service Commission (UPSC)</strong> conducts prestigious constitutional recruitment examinations including the Civil Services Examination (CSE), NDA & NA, and CDS.
          </p>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Meanwhile, school education is anchored by the <strong>Central Board of Secondary Education (CBSE)</strong> and <strong>CISCE</strong>, whose Class 10 and 12 certificates establish eligibility thresholds for subsequent higher education degree entrances and technical credentials.
          </p>
        </div>

        <div class="p-6 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
          <h3 class="font-display font-bold text-base text-slate-900 dark:text-white mb-2">
            Chronological Testing Phases & Annual Rhythms
          </h3>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
            The national testing calendar follows distinct seasonal phases. The <em>Spring Window (January–May)</em> features JEE Main Session 1 & 2, CBSE Board exams, NEET UG, and CUET UG. The <em>Monsoon Window (May–August)</em> is headlined by JEE Advanced, UPSC Civil Services Prelims, and State CETs.
          </p>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            The <em>Autumn & Winter Window (September–December)</em> encompasses UPSC CSE Mains descriptive assessments, CAT for IIMs, CLAT for National Law Universities, GATE for postgraduate engineering, and extensive banking recruitment cycles (IBPS & SBI).
          </p>
        </div>
      </div>

      <div class="p-6 sm:p-8 rounded-[24px] bg-slate-50 dark:bg-slate-900 border border-black/[0.06] dark:border-white/[0.08] space-y-4">
        <h3 class="font-display font-bold text-lg text-slate-900 dark:text-white">
          Why Backward Scheduling & Countdown Tracking Increases Rank Potential
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          Cognitive research demonstrates that unstructured preparation leads to disproportionate time spent on introductory modules while complex high-yield topics are rushed during the final month. Backward scheduling resolves this asymmetry by anchoring all revision milestones to the verified exam date:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs pt-2">
          <div class="p-4 rounded-xl bg-white dark:bg-[#171923] border border-black/[0.04] dark:border-white/[0.05]">
            <div class="font-bold text-slate-900 dark:text-white mb-1">1. Spaced Repetition Cycles</div>
            <p class="text-slate-500 dark:text-slate-400">Review foundational concepts at 7, 21, and 45-day intervals to convert short-term memory into long-term recall.</p>
          </div>
          <div class="p-4 rounded-xl bg-white dark:bg-[#171923] border border-black/[0.04] dark:border-white/[0.05]">
            <div class="font-bold text-slate-900 dark:text-white mb-1">2. Timed Shift Simulation</div>
            <p class="text-slate-500 dark:text-slate-400">Condition biological focus by writing 180-minute and 200-minute mock tests strictly during official exam hours (e.g. 9:00 AM or 2:00 PM).</p>
