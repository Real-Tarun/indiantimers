---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact & Feedback', url: '/contact/' },
];
---

<BaseLayout
  title="Contact Us & Report Schedule Updates | IndianTimers"
  description="Contact the IndianTimers editorial team, report an examination date change or postponement, or suggest new entrance examinations to track."
  canonicalUrl={`${siteConfig.url}/contact/`}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-2xl mx-auto">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 mb-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 mb-2">
        Contact & Schedule Change Reporting
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        Did an examination board release a new circular or reschedule an entrance test? Help us maintain 100% data accuracy.
      </p>
    </div>

    <div class="space-y-6 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
      <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs">
        <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 mb-2">
          Report an Exam Date Update
        </h2>
        <p class="mb-4 text-xs text-slate-500 leading-relaxed">
          Please include the official circular PDF link or official website announcement URL so our verification desk can audit and update the live countdown.
        </p>
        <div class="space-y-2 text-xs">
          <p>
            <strong>Editorial Email:</strong>{' '}
            <a href="mailto:updates@indiantimers.com" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
              updates@indiantimers.com
            </a>
          </p>
          <p>
            <strong>General Inquiries:</strong>{' '}
            <a href="mailto:contact@indiantimers.com" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
              contact@indiantimers.com
            </a>
          </p>
          <p class="text-[11px] text-slate-400 pt-2">
            Average response & audit turnaround: within 4 hours during active examination notification windows.
          </p>
        </div>
      </div>

      <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs">
        <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 mb-2">
          Suggest an Examination to Add
        </h2>
        <p class="text-xs text-slate-500 leading-relaxed">
          We continually expand our coverage across national, state, and university levels. If your state CET or professional qualification is not yet listed, drop our team an email with the conducting body details.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
