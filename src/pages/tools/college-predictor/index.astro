---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MarksVsPercentileCalculator from '../../../components/MarksVsPercentileCalculator';
import { siteConfig } from '../../../config/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Tools', url: '/tools/marks-vs-percentile/' },
  { name: 'College Predictor 2027', url: '/tools/college-predictor/' },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'JEE Main & NEET College Predictor 2027 (JoSAA & MCC Cutoffs)',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'INR',
  },
  description: 'Predict your admission chances in NITs, IIITs, GFTIs, AIIMS, and State Medical Colleges for JEE Main and NEET 2027 based on your score, shift difficulty, and category (GEN, OBC, EWS, SC, ST).',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What marks are needed in JEE Main 2027 for Computer Science (CSE) in Top NITs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For General Category candidates, securing CSE in Top 3 NITs (Trichy, Surathkal, Warangal) requires 240+ marks (99.7+ percentile, CRL within 2,500). For OBC-NCL and EWS, 210-220 marks are required. For SC and ST candidates, 150-165 marks (SC Rank within 400) secure premier NIT Computer Science seats.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can an SC or ST candidate get Government MBBS with 530 marks in NEET 2027?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, absolutely. Under the 15% All India Quota (AIQ) and State 85% Quota, the projected government MBBS closing cutoff for SC candidates is approximately 525+ marks, and for ST candidates is approximately 485–495 marks. Candidates with 550+ marks in SC/ST categories secure established state government medical colleges with 100% subsidized fees.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the difference between Common Rank List (CRL) and Category Rank in JoSAA?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'CRL (Common Rank List) is your overall All India Rank among all candidates who appeared in JEE Main. Category Rank is your specific merit rank among candidates within your reservation quota (GEN-EWS, OBC-NCL, SC, ST). JoSAA seat allocation first checks open CRL seats, and if not allotted, allocates reserved seats based on your Category Rank.',
      },
    },
    {
      '@type': 'Question',
      name: 'What NEET UG score is required for AIIMS New Delhi for OBC, EWS, and SC categories?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For AIIMS New Delhi, the General (UR) cutoff closes around AIR 55-65 (710+ marks). For OBC-NCL, it closes around AIR 220-250 (700+ marks). For EWS, around AIR 320-350 (695+ marks). For SC candidates, admission extends up to AIR 2,200–2,500 (665–670 marks), and for ST candidates up to AIR 4,200 (650+ marks).',
      },
    },
    {
      '@type': 'Question',
      name: 'What are CSAB Special Rounds and how do they benefit borderline JEE rankers?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Central Seat Allocation Board (CSAB) conducts two Special Vacancy Rounds after the conclusion of 6 JoSAA rounds. Vacant seats in NITs, IIITs, and GFTIs are allotted with significant cutoff relaxation (often 10,000 to 50,000 ranks lower than JoSAA Round 6), making it a golden opportunity for candidates with 85–95 percentile.',
      },
    },
  ],
};
---

<BaseLayout
  title="JEE Main & NEET College Predictor 2027: Category-Wise JoSAA & MCC Cutoffs | IndianTimers"
  description="Accurate college admission predictor for JEE Main (NITs, IIITs, GFTIs) and NEET UG 2027 (AIIMS, State GMCs). Category-wise cutoffs for General, OBC, EWS, SC, ST with 3-tier safe, target, and ambitious forecasts."
  canonicalUrl={`${siteConfig.url}/tools/college-predictor/`}
  breadcrumbs={breadcrumbs}
  schema={pageSchema}
>
  <!-- Breadcrumb & Header -->
  <div class="mb-8">
    <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/tools/marks-vs-percentile/" class="hover:underline">Tools</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">College Predictor 2027</span>
    </div>

    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black bg-[#D4FF4F] text-[#111406] shadow-xs mb-3">
      <span class="w-2 h-2 rounded-full bg-[#111406] animate-pulse"></span>
      2027 JoSAA &amp; MCC Admissions Intelligence
    </div>

    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mb-3 tracking-tight font-display">
      JEE Main &amp; NEET College Predictor 2027
    </h1>

    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
      Discover which engineering colleges (NITs, IIITs, GFTIs) or medical colleges (AIIMS, Central Institutes, State GMCs) you can convert with your mock test score. Fully calibrated with category-specific reservation quotas (General, OBC-NCL, EWS, SC, ST) and historical JoSAA &amp; MCC closing rank databases.
    </p>
  </div>

  <!-- Interactive Predictor Island -->
  <div class="mb-14">
    <MarksVsPercentileCalculator client:load />
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       EDITORIAL & ADMISSION CUTOFF RESEARCH (HIGH TEXT-TO-HTML FOR SEO)
  ══════════════════════════════════════════════════════════════════════════ -->
  <div class="space-y-12 max-w-4xl mx-auto">
    
    <!-- Section 1: JoSAA 2027 NIT & IIIT Category-Wise Cutoff Benchmarks -->
    <section class="bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] rounded-3xl p-6 sm:p-8 shadow-xs">
      <div class="flex items-center justify-between mb-4">
        <div>
          <span class="text-[10px] font-black uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
            JoSAA Counselling Benchmarks
          </span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white font-display">
            Top NITs Computer Science (CSE) Cutoffs by Category
          </h2>
        </div>
        <span class="text-xs font-bold px-3 py-1 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 rounded-full">
          Other State Quota (OS)
        </span>
      </div>

      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
        Below are the calibrated opening and closing category rank brackets for Computer Science &amp; Engineering (CSE) across India's premier NITs. Notice how reservation categories dramatically alter the closing cutoff score.
      </p>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-800/80 font-bold border-b border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-200">
            <tr>
              <th class="py-3 px-4">Institute</th>
              <th class="py-3 px-4">General (CRL)</th>
              <th class="py-3 px-4">OBC-NCL (CR)</th>
              <th class="py-3 px-4">EWS (CR)</th>
              <th class="py-3 px-4">SC (CR)</th>
              <th class="py-3 px-4">ST (CR)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-600 dark:text-slate-300 font-mono">
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">NIT Trichy</td>
              <td class="py-3 px-4 text-indigo-600 font-bold">AIR 450 - 1,480</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">120 - 410</td>
              <td class="py-3 px-4 text-amber-600 font-bold">90 - 240</td>
              <td class="py-3 px-4 text-purple-600 font-bold">45 - 210</td>
              <td class="py-3 px-4 text-rose-600 font-bold">20 - 95</td>
            </tr>
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">NIT Surathkal</td>
              <td class="py-3 px-4 text-indigo-600 font-bold">AIR 900 - 2,850</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">350 - 820</td>
              <td class="py-3 px-4 text-amber-600 font-bold">210 - 450</td>
              <td class="py-3 px-4 text-purple-600 font-bold">120 - 390</td>
              <td class="py-3 px-4 text-rose-600 font-bold">40 - 145</td>
            </tr>
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">NIT Warangal</td>
              <td class="py-3 px-4 text-indigo-600 font-bold">AIR 1,100 - 3,100</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">480 - 940</td>
              <td class="py-3 px-4 text-amber-600 font-bold">280 - 520</td>
              <td class="py-3 px-4 text-purple-600 font-bold">180 - 480</td>
              <td class="py-3 px-4 text-rose-600 font-bold">60 - 190</td>
            </tr>
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">NIT Rourkela</td>
              <td class="py-3 px-4 text-indigo-600 font-bold">AIR 2,400 - 7,200</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">1,100 - 2,450</td>
              <td class="py-3 px-4 text-amber-600 font-bold">650 - 1,280</td>
              <td class="py-3 px-4 text-purple-600 font-bold">420 - 1,150</td>
              <td class="py-3 px-4 text-rose-600 font-bold">150 - 420</td>
            </tr>
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">MNNIT Allahabad</td>
              <td class="py-3 px-4 text-indigo-600 font-bold">AIR 2,800 - 5,900</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">950 - 1,980</td>
              <td class="py-3 px-4 text-amber-600 font-bold">580 - 1,050</td>
              <td class="py-3 px-4 text-purple-600 font-bold">380 - 980</td>
              <td class="py-3 px-4 text-rose-600 font-bold">130 - 380</td>
            </tr>
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">NIT Calicut</td>
              <td class="py-3 px-4 text-indigo-600 font-bold">AIR 3,200 - 9,400</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">1,400 - 3,100</td>
              <td class="py-3 px-4 text-amber-600 font-bold">850 - 1,600</td>
              <td class="py-3 px-4 text-purple-600 font-bold">600 - 1,450</td>
              <td class="py-3 px-4 text-rose-600 font-bold">220 - 560</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: MCC NEET UG 2027 Medical College Cutoff Benchmarks -->
    <section class="bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] rounded-3xl p-6 sm:p-8 shadow-xs">
      <div class="flex items-center justify-between mb-4">
        <div>
          <span class="text-[10px] font-black uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
            MCC Medical Allotment Intelligence
          </span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white font-display">
            NEET UG MBBS Closing Marks &amp; Ranks by Category
          </h2>
        </div>
        <span class="text-xs font-bold px-3 py-1 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 rounded-full">
          AIQ 15% Quota
        </span>
      </div>

      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
        Normalized projections for NEET 2027 across prestigious central medical institutions and state government medical colleges.
      </p>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-800/80 font-bold border-b border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-200">
            <tr>
              <th class="py-3 px-4">Institution Name</th>
              <th class="py-3 px-4">General / UR</th>
              <th class="py-3 px-4">OBC-NCL</th>
              <th class="py-3 px-4">EWS</th>
              <th class="py-3 px-4">SC Quota</th>
              <th class="py-3 px-4">ST Quota</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-600 dark:text-slate-300 font-mono">
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">AIIMS New Delhi</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">710+ (AIR 55)</td>
              <td class="py-3 px-4 font-bold">702+ (AIR 240)</td>
              <td class="py-3 px-4 font-bold">698+ (AIR 330)</td>
              <td class="py-3 px-4 font-bold">668+ (AIR 2,400)</td>
              <td class="py-3 px-4 font-bold">652+ (AIR 4,200)</td>
            </tr>
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">MAMC New Delhi</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">705+ (AIR 95)</td>
              <td class="py-3 px-4 font-bold">695+ (AIR 480)</td>
              <td class="py-3 px-4 font-bold">692+ (AIR 580)</td>
              <td class="py-3 px-4 font-bold">658+ (AIR 3,800)</td>
              <td class="py-3 px-4 font-bold">642+ (AIR 6,100)</td>
            </tr>
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">AIIMS Bhopal / Jodhpur</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">678+ (AIR 1,200)</td>
              <td class="py-3 px-4 font-bold">670+ (AIR 2,100)</td>
              <td class="py-3 px-4 font-bold">665+ (AIR 2,600)</td>
              <td class="py-3 px-4 font-bold">615+ (AIR 16,500)</td>
              <td class="py-3 px-4 font-bold">585+ (AIR 32,000)</td>
            </tr>
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">KGMU Lucknow</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">668+ (AIR 2,200)</td>
              <td class="py-3 px-4 font-bold">660+ (AIR 3,400)</td>
              <td class="py-3 px-4 font-bold">658+ (AIR 3,800)</td>
              <td class="py-3 px-4 font-bold">595+ (AIR 26,000)</td>
              <td class="py-3 px-4 font-bold">560+ (AIR 48,000)</td>
            </tr>
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white font-sans">AIQ 15% Safe Govt MBBS</td>
              <td class="py-3 px-4 text-emerald-600 font-bold">628+ (AIR 22,000)</td>
              <td class="py-3 px-4 font-bold">622+ (AIR 23,500)</td>
              <td class="py-3 px-4 font-bold">620+ (AIR 24,000)</td>
              <td class="py-3 px-4 font-bold">525+ (AIR 1,18,000)</td>
              <td class="py-3 px-4 font-bold">490+ (AIR 1,52,000)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 3: JoSAA vs MCC Counselling Workflow -->
    <section class="bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] rounded-3xl p-6 sm:p-8 shadow-xs">
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white font-display mb-4">
        Counselling Architecture: JoSAA, CSAB, MCC &amp; State Quotas
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/60 space-y-2">
          <span class="font-bold text-slate-900 dark:text-white block text-sm">
            ⚡ JoSAA &amp; CSAB (Engineering Architecture)
          </span>
          <p class="leading-relaxed">
            JoSAA conducts 6 online counselling rounds for 23 IITs, 32 NITs, 26 IIITs, and 38 GFTIs. Candidates choose between <em>Float</em>, <em>Slide</em>, and <em>Freeze</em>. Following JoSAA Round 6, vacant seats move to CSAB Special Rounds, offering massive rank relaxations for mid-percentile candidates.
          </p>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/60 space-y-2">
          <span class="font-bold text-slate-900 dark:text-white block text-sm">
            🩺 MCC &amp; State DGs (Medical Architecture)
          </span>
          <p class="leading-relaxed">
            Medical seat allocation is divided into 15% All India Quota (AIQ) administered by the Medical Counselling Committee (MCC), and 85% State Quota managed by individual State DME portals. Central AIIMS and JIPMER are 100% allotted through MCC All India Rounds.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 4: Frequently Asked Questions -->
    <section class="bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] rounded-3xl p-6 sm:p-8 shadow-xs">
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white font-display mb-6">
        Frequently Asked Questions: College Predictions &amp; Cutoffs
      </h2>

      <div class="space-y-4">
        {faqSchema.mainEntity.map((item) => (
          <details class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/60 cursor-pointer group">
            <summary class="font-bold text-sm text-slate-900 dark:text-white flex items-center justify-between select-none list-none">
              <span>{item.name}</span>
              <span class="text-xs transition-transform group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {item.acceptedAnswer.text}
            </p>
          </details>
        ))}
      </div>
    </section>

  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
