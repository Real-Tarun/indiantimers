---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { EXAM_REGISTRY } from '../../../data/exams';
import { siteConfig } from '../../../config/site';

// Sort chronologically by exam date
const sortedCalendarExams = [...EXAM_REGISTRY].sort(
  (a, b) => new Date(a.dates.examDate).getTime() - new Date(b.dates.examDate).getTime()
);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Exam Calendar 2027', url: '/calendar/2027/' },
];
---

<BaseLayout
  title="Indian Exam Calendar 2027: Complete Schedule & Official Dates | IndianTimers"
  description="Comprehensive 2027 Indian examination calendar. Verified exam dates, tentative schedules, conducting bodies, and session timings for NEET, JEE, UPSC, GATE, CBSE, and State Boards."
  canonicalUrl={`${siteConfig.url}/calendar/2027/`}
  breadcrumbs={breadcrumbs}
>
  <div class="mb-8">
    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-2 font-medium">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-bold">Calendar 2027</span>
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-2 font-display">
          Indian Examination Master Calendar 2027
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
          Chronological index of national competitive exams, university entrances, and school boards. Every date links directly to its audited source notification.
        </p>
      </div>

      <button
        type="button"
        onclick="window.print()"
        class="no-print self-start md:self-auto btn-ghost text-xs font-bold"
      >
        <span>Print Calendar</span>
      </button>
    </div>
  </div>

  {/* Compact Master Calendar Table (Flux Bento Card) */}
  <div class="rounded-[24px] border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-[#171923] overflow-hidden shadow-xs">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 font-bold border-b border-black/[0.05] dark:border-white/[0.05]">
          <tr>
            <th class="py-4 px-5 whitespace-nowrap">Exam Date</th>
            <th class="py-4 px-5 whitespace-nowrap">Examination Name</th>
            <th class="py-4 px-5 whitespace-nowrap">Conducting Body</th>
            <th class="py-4 px-5 whitespace-nowrap">Status</th>
            <th class="py-4 px-5 whitespace-nowrap">Session Timings</th>
            <th class="py-4 px-5 text-right whitespace-nowrap">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/[0.04] dark:divide-white/[0.05]">
          {sortedCalendarExams.map((exam) => (
            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
              <td class="py-3.5 px-5 font-bold text-slate-900 dark:text-white whitespace-nowrap">
                {exam.dates.examDate}
                {exam.dates.examEndDate && (
                  <span class="block text-[10px] font-normal text-slate-400">
                    to {exam.dates.examEndDate}
                  </span>
                )}
              </td>
              <td class="py-3.5 px-5">
                <a
                  href={`/exams/${exam.slug}/`}
                  class="font-bold text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-[#D4FF4F] transition-colors block"
                >
                  {exam.shortName}
                </a>
                <span class="text-[11px] text-slate-400 truncate max-w-xs block">
                  {exam.name}
                </span>
              </td>
              <td class="py-3.5 px-5 text-slate-600 dark:text-slate-300 whitespace-nowrap">
                {exam.conductingAuthority}
              </td>
              <td class="py-3.5 px-5 whitespace-nowrap">
                {exam.dateStatus === 'official' ? (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-[#D4FF4F] text-[#111406] shadow-xs">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#111406] animate-pulse"></span>
                    Official
                  </span>
                ) : exam.dateStatus === 'tentative' ? (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-950/80 text-amber-900 dark:text-amber-300 border border-amber-300/40">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    Tentative
                  </span>
                ) : (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-500">
                    TBA
                  </span>
                )}
              </td>
              <td class="py-3.5 px-5 text-slate-500 dark:text-slate-400 whitespace-nowrap">
                {exam.startTime ? `${exam.startTime} IST` : 'Shift details TBA'}
              </td>
              <td class="py-3.5 px-5 text-right whitespace-nowrap">
                <a
                  href={`/exams/${exam.slug}/`}
                  class="text-xs font-bold text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-[#D4FF4F] transition-colors"
                >
                  View Details →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Editorial Analysis & Strategic Planning Guide for 2027 Aspirants -->
  <section class="mt-16 pt-10 border-t border-slate-200 dark:border-slate-800 space-y-10 text-slate-700 dark:text-slate-300">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 mb-3">
        <span>Calendar Advisory & Timeline Analysis</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-3 font-display">
        Understanding the 2027 Indian Competitive Testing Cycle
      </h2>
      <p class="text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-400">
        Planning an entire academic year around competitive entrances requires deep awareness of conducting authorities' notification rhythms. National bodies such as the National Testing Agency (NTA), Union Public Service Commission (UPSC), Indian Institutes of Management (IIMs), and Central Board of Secondary Education (CBSE) adhere to strict annual scheduling windows designed to prevent overlapping examinations and facilitate timely university admissions.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08]">
        <h3 class="font-bold text-base text-slate-900 dark:text-slate-100 mb-2">Quarter 1: The Undergraduate Sprint</h3>
        <p class="text-xs font-semibold text-blue-600 dark:text-blue-400 mb-2">January to March 2027</p>
        <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          The year begins with JEE Main Session 1 in late January, offering engineering aspirants their initial benchmark score. February and March are critical transitional months where CBSE Class 10 and 12 board examinations run parallel to GATE (Graduate Aptitude Test in Engineering) for postgraduate engineers and PSU recruitment aspirants.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08]">
        <h3 class="font-bold text-base text-slate-900 dark:text-slate-100 mb-2">Quarter 2: High-Volume Mega Entrances</h3>
        <p class="text-xs font-semibold text-amber-600 dark:text-amber-400 mb-2">April to June 2027</p>
        <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          April witnesses JEE Main Session 2 and NDA examination, followed by NEET UG on the first Sunday of May with over 2.4 million medical candidates. Late May and June feature JEE Advanced for the top 2.5 lakh engineering qualifiers, alongside UPSC Civil Services Preliminary examination and CUET UG across central universities.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08]">
        <h3 class="font-bold text-base text-slate-900 dark:text-slate-100 mb-2">Quarter 4: Postgraduate Selection Seasons</h3>
        <p class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 mb-2">September to December 2027</p>
        <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          The autumn and winter calendar is headlined by prestigious management and postgraduate law examinations. UPSC Civil Services Main descriptive examinations occur in September, followed by the Common Admission Test (CAT) on the final Sunday of November, leading into CLAT and XAT in early December.
        </p>
      </div>
    </div>

    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
      <h3 class="font-bold text-lg text-slate-900 dark:text-slate-100 mb-3">
        Chronological Backward Scheduling for Competitive Aspirants
      </h3>
      <div class="space-y-3 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
        <p>
          Successful aspirants reverse-engineer their daily study schedules starting from the exam date displayed on the calendar above. Standard practice divides the timeline into three distinct operational blocks:
        </p>
        <ol class="list-decimal pl-5 space-y-2">
          <li><strong>Foundation & Syllabus Coverage (Months 12 to 5 before Exam):</strong> Deep conceptual clarity, NCERT text mastery, chapter-wise problem banks, and formula register formulation.</li>
          <li><strong>Consolidation & Sectional Mock Drills (Months 4 to 2 before Exam):</strong> Transitioning from chapter practice to full multi-subject sectional tests, identifying time-drain topics, and refining question selection judgment.</li>
          <li><strong>Full Simulation & Peak Tapering (Final 60 Days):</strong> Strict 3-hour mock tests held exactly during scheduled shift timings (e.g. 9:00 AM – 12:00 PM), combined with deep error log review and physical sleep cycle alignment.</li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
