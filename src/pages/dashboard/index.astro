---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonalDashboard from '../../components/PersonalDashboard';
import { siteConfig } from '../../config/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Personal Dashboard', url: '/dashboard/' },
];
---

<BaseLayout
  title="My Study Dashboard: Saved Countdowns & Focus History | IndianTimers"
  description="Personalized student dashboard tracking your pinned official exams, custom test deadlines, today's focus hours, and weekly study streaks."
  canonicalUrl={`${siteConfig.url}/dashboard/`}
  robots="noindex, nofollow"
  breadcrumbs={breadcrumbs}
>
  <div class="mb-8">
    <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">Dashboard</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 mb-2">
      Personal Student Dashboard
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
      Your private mission control for exams and study timers. Stored entirely in your browser without requiring registration or passwords.
    </p>
  </div>

  <PersonalDashboard client:load />
</BaseLayout>
