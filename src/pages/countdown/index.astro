---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareableCountdown from '../../components/ShareableCountdown';
import { siteConfig } from '../../config/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Countdowns', url: '/tools/countdown/' },
  { name: 'Live Countdown', url: '/countdown/' },
];
---

<BaseLayout
  title="Live Exam Countdown Timer | Shareable & Accurate | IndianTimers"
  description="Accurate live exam countdown clock. View remaining days, hours, and minutes for upcoming tests, mock exams, and academic milestones."
  canonicalUrl={`${siteConfig.url}/countdown/`}
  breadcrumbs={breadcrumbs}
>
  <div class="mb-6 sm:mb-8 text-center max-w-xl mx-auto">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 mb-3">
      <span class="w-2 h-2 rounded-full bg-[#D4FF4F]"></span>
      <span>Live Precision Ticker</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 mb-2">
      Exam Countdown Timer
    </h1>
    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
      Real-time countdown synchronization with second-by-second accuracy. Easily saveable to your private personal cockpit.
    </p>
  </div>

  <ShareableCountdown client:load />
</BaseLayout>
