---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CountdownCard from '../../components/CountdownCard';
import { EXAM_REGISTRY, toDirectoryExam } from '../../data/exams';
import { siteConfig } from '../../config/site';
import { getGoogleCalendarUrl } from '../../utils/calendar';
import { getDetailedExamContent } from '../../utils/examContent';
import { getExamJsonLd } from '../../utils/examSchema';
import type { ExamRecord } from '../../types/exam';

export async function getStaticPaths() {
  return EXAM_REGISTRY.map((exam) => ({
    params: { slug: exam.slug },
    props: { exam },
  }));
}

interface Props {
  exam: ExamRecord;
}

const { exam } = Astro.props;
const detailedContent = getDetailedExamContent(exam);

// Related exams lookup
const relatedExams = EXAM_REGISTRY.filter((e) =>
  exam.relatedExamIds.includes(e.id)
);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Exams', url: '/exams/' },
  { name: exam.shortName, url: `/exams/${exam.slug}/` },
];

const googleCalUrl = getGoogleCalendarUrl(exam, siteConfig.url);

// JSON-LD structured data for Exam Page (Google Search Console compliant with Event, description, image, performer, offers)
const examJsonLd = getExamJsonLd(exam, siteConfig.url);

// Combine all FAQs for Rich Snippets
const allFaqs = [...(exam.faqs || []), ...detailedContent.additionalFaqs];

const faqJsonLd = allFaqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;

const schemas = faqJsonLd ? [examJsonLd, faqJsonLd] : [examJsonLd];
---

<BaseLayout
  title={`${exam.shortName} Countdown: Exam Date, Schedule & Timing | IndianTimers`}
  description={`Accurate live countdown to ${exam.shortName} (${exam.dates.examDate}). Verified status: ${exam.dateStatus}. Official notification, session timings, and mock timers.`}
  canonicalUrl={`${siteConfig.url}/exams/${exam.slug}/`}
  breadcrumbs={breadcrumbs}
  schema={schemas}
>
  {/* Breadcrumb Bar */}
  <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-medium" aria-label="Breadcrumb">
    <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
    <span>/</span>
    <a href="/exams/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Exams</a>
    <span>/</span>
    <a href={`/exams/${exam.category}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors capitalize">{exam.category.replace(/-/g, ' ')}</a>
    <span>/</span>
    <span class="text-slate-900 dark:text-white font-bold">{exam.shortName}</span>
  </nav>

  {/* Header Section */}
  <div class="mb-8">
    <div class="flex flex-wrap items-center gap-2.5 mb-3">
      {exam.dateStatus === 'official' ? (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-[#D4FF4F] text-[#111406] shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#111406] animate-pulse"></span>
          Official Confirmed Schedule
        </span>
      ) : exam.dateStatus === 'tentative' ? (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 dark:bg-amber-950/80 dark:text-amber-300 border border-amber-300/40">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          Tentative Official Calendar Schedule
        </span>
      ) : (
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
          Awaiting Official Notification
        </span>
      )}

      <span class="text-xs text-slate-500 dark:text-slate-400">
        Conducting Authority: <strong class="text-slate-800 dark:text-slate-200">{exam.conductingAuthority}</strong>
      </span>
    </div>

    <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight mb-3 tracking-tight font-display">
      {exam.name}
    </h1>

    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
      {exam.shortDescription}
    </p>
  </div>

  {/* Main Grid: Live Countdown Hero + Content Sections */}
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
    {/* Left 2 Cols: Main Content */}
    <div class="lg:col-span-2 space-y-8">
      {/* Live Countdown Hero Card */}
      <CountdownCard client:load exam={toDirectoryExam(exam)} showDetailsLink={false} />

      {/* Live Exam Alerts & Community Channels */}
      <div class="p-4 sm:p-5 rounded-[22px] bg-gradient-to-r from-emerald-500/10 via-[#0088cc]/10 to-transparent border border-emerald-500/20 dark:border-[#0088cc]/30 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="flex items-start sm:items-center gap-3.5">
          <div class="w-10 h-10 rounded-2xl bg-[#18181B] dark:bg-white text-white dark:text-[#111406] flex items-center justify-center shrink-0 shadow-xs text-lg">
            🔔
          </div>
          <div>
            <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 mb-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
              Instant Official Alerts
            </div>
            <h3 class="font-display font-bold text-sm text-slate-900 dark:text-white leading-snug">
              Get {exam.shortName} Notifications &amp; Daily Countdowns
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">
              Instant NTA/conducting body circulars, morning motivation, and practice quizzes.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2.5 w-full md:w-auto shrink-0">
          <a
            href={siteConfig.links.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            data-community="whatsapp"
            data-track-cta="exam_detail"
            class="flex-1 md:flex-initial text-center px-4 py-2 rounded-full font-bold text-xs bg-emerald-600 hover:bg-emerald-700 text-white transition-all shadow-xs hover:scale-105 inline-flex items-center justify-center gap-1.5"
          >
            <span>WhatsApp</span>
            <span>→</span>
          </a>
          <a
            href={siteConfig.links.telegram}
            target="_blank"
            rel="noopener noreferrer"
            data-community="telegram"
            data-track-cta="exam_detail"
            class="flex-1 md:flex-initial text-center px-4 py-2 rounded-full font-bold text-xs bg-[#0088cc] hover:bg-[#0077b5] text-white transition-all shadow-xs hover:scale-105 inline-flex items-center justify-center gap-1.5"
          >
            <span>Telegram</span>
            <span>→</span>
          </a>
        </div>
      </div>

      {/* Calendar Sync & Export Pill Row */}
      <div class="p-5 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex flex-wrap items-center gap-2.5">
          <a
            href={googleCalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-full font-bold bg-[#18181B] dark:bg-white text-white dark:text-[#111406] hover:bg-black dark:hover:bg-slate-100 transition-all inline-flex items-center gap-1.5 shadow-xs"
          >
            <svg class="w-3.5 h-3.5 text-[#D4FF4F] dark:text-[#18181B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            Add to Google Calendar
          </a>

          <button
            type="button"
            id="fullscreen-trigger-btn"
            class="px-4 py-2 rounded-full font-bold bg-white dark:bg-slate-800 border border-black/[0.08] dark:border-white/[0.1] text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition-all inline-flex items-center gap-1.5 shadow-xs cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
            </svg>
            Full Screen Mode
          </button>
        </div>

        <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
          <span>Verified on: <strong class="text-slate-800 dark:text-slate-200">{exam.lastVerified}</strong></span>
        </div>
      </div>

      {/* Official Notification & Audit Provenance Box */}
      <div class="p-6 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs text-xs">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-[#D4FF4F]"></span>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white">
            Official Circular Citation & Provenance
          </h3>
        </div>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
          This examination schedule is published pursuant to: <strong class="text-slate-900 dark:text-white">"{exam.sourceNotificationTitle}"</strong> issued by {exam.conductingAuthority}.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-black/[0.05] dark:border-white/[0.05]">
          <a
            href={exam.officialSourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost btn-sm text-xs font-bold"
          >
            Open Official Circular Portal ↗
          </a>
          <a
            href={exam.officialWebsite}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost btn-sm text-xs font-semibold text-slate-600 dark:text-slate-300"
          >
            Conducting Authority Portal ↗
          </a>
        </div>
      </div>

      {/* 1. In-Depth About & Overview */}
      <div class="p-6 sm:p-8 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-3 font-display">
          About {exam.name}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
          {exam.detailedOverview}
        </p>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Administered annually by {exam.conductingAuthority}, this examination serves as a critical national gateway for students seeking admission and career appointment across premier Indian institutions. Maintaining an accurate, drift-free second-by-second countdown is essential for candidates to budget revision phases, track registration windows, and build circadian rhythm synchronization for their scheduled test shift.
        </p>
      </div>

      {/* 2. Comprehensive Examination Pattern & Marking Scheme */}
      <div class="p-6 sm:p-8 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-4 font-display">
          {exam.shortName} Examination Pattern & Marking Scheme
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Understanding the examination architecture and scoring blueprint enables candidates to avoid negative marking penalties, calibrate section-by-section time budgets, and maximize composite percentile ranks.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs mb-6">
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80">
            <span class="text-slate-500 dark:text-slate-400 block mb-1">Testing Mode:</span>
            <strong class="text-slate-900 dark:text-white">{detailedContent.pattern.mode}</strong>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80">
            <span class="text-slate-500 dark:text-slate-400 block mb-1">Total Questions:</span>
            <strong class="text-slate-900 dark:text-white">{detailedContent.pattern.totalQuestions}</strong>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80">
            <span class="text-slate-500 dark:text-slate-400 block mb-1">Total Marks:</span>
            <strong class="text-slate-900 dark:text-white">{detailedContent.pattern.totalMarks}</strong>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80">
            <span class="text-slate-500 dark:text-slate-400 block mb-1">Official Test Duration:</span>
            <strong class="text-slate-900 dark:text-white">{detailedContent.pattern.durationText}</strong>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/40 text-xs mb-6">
          <h4 class="font-bold text-amber-900 dark:text-amber-300 mb-1">Scoring & Negative Marking Rules</h4>
          <p class="text-amber-800 dark:text-amber-200 leading-relaxed">
            {detailedContent.pattern.markingScheme}
          </p>
        </div>

        <div class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <p>• <strong>Medium of Examination:</strong> {detailedContent.pattern.medium}</p>
          <p>• <strong>Shift Timing Breakdown:</strong> {detailedContent.pattern.shifts}</p>
        </div>
      </div>

      {/* 3. Subject Breakdown & High-Yield Topic Weightage */}
      <div class="p-6 sm:p-8 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-4 font-display">
          Curriculum Breakdown & High-Yield Section Weightage
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Analyze historical question distribution and topic weightage to prioritize syllabus coverage effectively:
        </p>

        <div class="space-y-6">
          {detailedContent.sections.map((sec) => (
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-700/80">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">{sec.name}</h3>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#18181B] dark:bg-white text-white dark:text-[#111406]">
                  {sec.weightage}
                </span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
                {sec.strategy}
              </p>
              <div class="text-xs">
                <span class="font-bold text-slate-700 dark:text-slate-300 block mb-1">High-Frequency Topics:</span>
                <div class="flex flex-wrap gap-1.5">
                  {sec.keyTopics.map((topic) => (
                    <span class="px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-[11px]">
                      {topic}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* 4. Phase-by-Phase Preparation Timetable & Countdown Strategy */}
      <div class="p-6 sm:p-8 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-4 font-display">
          Phase-by-Phase Countdown Strategy & Revision Timetable
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Structure your daily study routine into progressive milestones mapped against the countdown deadline:
        </p>

        <div class="space-y-6">
          {detailedContent.phases.map((phase, idx) => (
            <div class="border-l-2 border-[#18181B] dark:border-[#D4FF4F] pl-4 sm:pl-6 space-y-2">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-black uppercase tracking-wider text-slate-400">Stage 0{idx + 1}</span>
                <span class="text-xs font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">{phase.timeframe}</span>
              </div>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">{phase.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{phase.focus}</p>
              <ul class="space-y-1 text-xs text-slate-600 dark:text-slate-300 list-disc list-inside pt-1">
                {phase.deliverables.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      {/* 5. Exam Day Center Guidelines & Code of Conduct */}
      <div class="p-6 sm:p-8 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-4 font-display">
          Official Examination Day Code of Conduct & Guidelines
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Adhere strictly to official conducting authority instructions to prevent disqualification or reporting delays:
        </p>

        <div class="space-y-5 text-xs">
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white mb-2">Mandatory Documents to Carry</h3>
            <ul class="space-y-1.5 text-slate-600 dark:text-slate-300 list-disc list-inside">
              {detailedContent.examDayGuidelines.mandatoryDocuments.map((doc) => (
                <li>{doc}</li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="font-bold text-rose-600 dark:text-rose-400 mb-2">Strictly Prohibited Items</h3>
            <ul class="space-y-1.5 text-slate-600 dark:text-slate-300 list-disc list-inside">
              {detailedContent.examDayGuidelines.prohibitedItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="font-bold text-slate-900 dark:text-white mb-2">Prescribed Dress Code Advisory</h3>
            <ul class="space-y-1.5 text-slate-600 dark:text-slate-300 list-disc list-inside">
              {detailedContent.examDayGuidelines.dressCode.map((rule) => (
                <li>{rule}</li>
              ))}
            </ul>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700">
            <strong class="text-slate-900 dark:text-white block mb-1">Center Entry & Reporting Protocol:</strong>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
              {detailedContent.examDayGuidelines.reportingProtocol}
            </p>
          </div>
        </div>
      </div>

      {/* 6. Eligibility & Admit Card Protocols */}
      <div class="p-6 sm:p-8 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-4 font-display">
          Eligibility Standards & Admit Card Verification
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white mb-3">Eligibility & Qualifying Criteria</h3>
            <ul class="space-y-2 text-slate-600 dark:text-slate-300 list-disc list-inside">
              {detailedContent.eligibilitySummary.map((elig) => (
                <li>{elig}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white mb-3">Admit Card Protocol</h3>
            <ul class="space-y-2 text-slate-600 dark:text-slate-300 list-disc list-inside">
              {detailedContent.admitCardProtocol.map((rule) => (
                <li>{rule}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    {/* Right Sidebar: Timeline Milestones + Study Tools */}
    <div class="space-y-6">
      {/* Important Dates Table */}
      <div class="p-6 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-4 pb-2 border-b border-black/[0.05] dark:border-white/[0.05]">
          Critical Schedule Milestones
        </h3>

        <div class="space-y-3 text-xs">
          <div class="flex items-center justify-between py-1">
            <span class="text-slate-500 dark:text-slate-400">Exam Date:</span>
            <span class="font-bold text-slate-900 dark:text-white">{exam.dates.examDate}</span>
          </div>
          {exam.dates.examEndDate && (
            <div class="flex items-center justify-between py-1">
              <span class="text-slate-500 dark:text-slate-400">Concluding Date:</span>
              <span class="font-bold text-slate-900 dark:text-white">{exam.dates.examEndDate}</span>
            </div>
          )}
          {exam.startTime && (
            <div class="flex items-center justify-between py-1">
              <span class="text-slate-500 dark:text-slate-400">Session Timing:</span>
              <span class="font-semibold text-slate-800 dark:text-slate-200">
                {exam.startTime} - {exam.endTime || 'Closing'} IST
              </span>
            </div>
          )}
          {exam.dates.registrationStart && (
            <div class="flex items-center justify-between py-1">
              <span class="text-slate-500 dark:text-slate-400">Registration Opens:</span>
              <span class="font-medium text-slate-700 dark:text-slate-300">{exam.dates.registrationStart}</span>
            </div>
          )}
          {exam.dates.registrationEnd && (
            <div class="flex items-center justify-between py-1">
              <span class="text-slate-500 dark:text-slate-400">Registration Closes:</span>
              <span class="font-medium text-slate-700 dark:text-slate-300">{exam.dates.registrationEnd}</span>
            </div>
          )}
          {exam.dates.admitCardRelease && (
            <div class="flex items-center justify-between py-1">
              <span class="text-slate-500 dark:text-slate-400">Admit Card:</span>
              <span class="font-medium text-slate-700 dark:text-slate-300">{exam.dates.admitCardRelease}</span>
            </div>
          )}
          {exam.dates.resultDate && (
            <div class="flex items-center justify-between py-1">
              <span class="text-slate-500 dark:text-slate-400">Expected Result:</span>
              <span class="font-medium text-slate-700 dark:text-slate-300">{exam.dates.resultDate}</span>
            </div>
          )}
        </div>
      </div>

      {/* Relevant Focus Tools */}
      <div class="p-6 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-2">
          Practice & Timing Tools
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
          Prepare under simulated examination conditions.
        </p>

        <div class="space-y-2.5">
          <a
            href="/tools/mock-test-timer/"
            class="block p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 hover:bg-[#D4FF4F]/15 dark:hover:bg-[#D4FF4F]/10 border border-slate-200/80 dark:border-slate-700/80 transition-all group"
          >
            <span class="text-xs font-bold text-slate-900 dark:text-white block group-hover:text-black dark:group-hover:text-[#D4FF4F]">
              Mock Test Pacing Simulator →
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">
              Run official {exam.durationMinutes || 180} minute test simulation with time-per-question timer.
            </span>
          </a>

          <a
            href="/tools/pomodoro-timer/"
            class="block p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 hover:bg-[#D4FF4F]/15 dark:hover:bg-[#D4FF4F]/10 border border-slate-200/80 dark:border-slate-700/80 transition-all group"
          >
            <span class="text-xs font-bold text-slate-900 dark:text-white block group-hover:text-black dark:group-hover:text-[#D4FF4F]">
              50/10 Pomodoro Study Interval →
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">
              Structured daily focus cycles with wake lock.
            </span>
          </a>
        </div>
      </div>

      {/* Related Examinations */}
      {relatedExams.length > 0 && (
        <div class="p-6 rounded-[22px] bg-white dark:bg-[#171923] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-3">
            Related Examinations
          </h3>
          <ul class="space-y-2 text-xs">
            {relatedExams.map((re) => (
              <li>
                <a
                  href={`/exams/${re.slug}/`}
                  class="text-slate-700 dark:text-slate-300 hover:text-black dark:hover:text-[#D4FF4F] font-medium block"
                >
                  {re.shortName} <span class="text-slate-400">({re.dates.examDate})</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>

  {/* Real Questions & Answers FAQ Section */}
  {allFaqs.length > 0 && (
    <section class="max-w-4xl mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-6 font-display">
        {exam.shortName} Frequently Asked Questions
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {allFaqs.map((faq) => (
          <div class="p-5 rounded-[22px] border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-[#171923] shadow-xs">
            <h3 class="text-xs font-bold text-slate-900 dark:text-white mb-2 leading-snug">
              {faq.question}
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  )}

  <script>
    document.getElementById('fullscreen-trigger-btn')?.addEventListener('click', () => {
      const trigger = document.querySelector<HTMLButtonElement>('[aria-label="Enter full screen countdown"]');
      trigger?.click();
    });
  </script>
</BaseLayout>
