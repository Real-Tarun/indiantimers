---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExamDirectory from '../../components/ExamDirectory';
import { EXAM_REGISTRY } from '../../data/exams';
import { siteConfig } from '../../config/site';

const otherExams = EXAM_REGISTRY.filter((e) => e.category === 'other-entrance-exams');
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Exams', url: '/exams/' },
  { name: 'Other Entrances', url: '/exams/other-entrance-exams/' },
];
---

<BaseLayout
  title="National Entrance & Creative Exam Countdowns 2026-2027 | CUET, NIFT, NID, CA | IndianTimers"
  description="Live countdowns and verified dates for NTA CUET UG, NIFT B.Des, NID DAT, UCEED, NATA Architecture, and ICAI CA Foundation."
  canonicalUrl={`${siteConfig.url}/exams/other-entrance-exams/`}
  breadcrumbs={breadcrumbs}
>
  <div class="mb-8">
    <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/exams/" class="hover:underline">Exams</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">Other Entrances</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 mb-2">
      University, Design & Professional Exam Countdowns (2026-2027)
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
      Schedules for Common University Entrance Test (CUET UG/PG), premier design colleges (NID, NIFT, UCEED), architecture (NATA), and Chartered Accountancy (ICAI CA).
    </p>
  </div>

  <ExamDirectory client:load initialExams={otherExams} initialCategory="other-entrance-exams" />
</BaseLayout>
