---
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  robots?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title = `${siteConfig.name} - ${siteConfig.tagline}`,
  description = siteConfig.description,
  canonicalUrl,
  robots = 'index, follow',
  ogType = 'website',
  ogImage = `${siteConfig.url}/og-image.png`,
  schema,
  breadcrumbs,
} = Astro.props;

// Ensure clean canonical URL strictly on production canonical domain
let formattedCanonical: string;
if (canonicalUrl) {
  formattedCanonical = canonicalUrl.endsWith('/') ? canonicalUrl : `${canonicalUrl}/`;
} else {
  const cleanPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
  formattedCanonical = `${siteConfig.url}${cleanPath}`;
}

// Organization Schema
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  url: siteConfig.url,
  logo: `${siteConfig.url}/logo-512.png`,
  description: siteConfig.description,
};

// Breadcrumb Schema
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: b.name,
    item: b.url.startsWith('http') ? b.url : `${siteConfig.url}${b.url}`,
  })),
} : null;
---

<!DOCTYPE html>
<html lang="en-IN" class="scroll-smooth overflow-x-hidden w-full max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Google tag (gtag.js) */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NMK73HSYL7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-NMK73HSYL7');
    </script>

    {/* Microsoft Clarity Tracking Code */}
    <script is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z17jvnylcp");
    </script>
    
    {/* Favicon Suite — Standard, Retina, Google Search Snippet (48px) & iOS */}
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#18181B" />
    {/* Google Fonts preconnect */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {/* Primary SEO Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={formattedCanonical} />
    <meta name="robots" content={robots} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={formattedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_IN" />

    {/* Twitter */}
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={formattedCanonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    {/* Inline Theme Detection — Light Mode by Default */}
    <script is:inline>
      try {
        const storedTheme = localStorage.getItem('indiantimers_theme');
        if (storedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {
        document.documentElement.classList.remove('dark');
      }
    </script>

    {/* Structured Data (JSON-LD) */}
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(Array.isArray(schema) ? schema : [schema])}
      />
    )}
  </head>
  <body class="flex flex-col min-h-screen bg-[var(--bg-base)] text-[var(--text-primary)] antialiased transition-colors duration-150 overflow-x-hidden w-full max-w-full">
    {/* Accessible skip link */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-md text-xs font-semibold"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <slot />
    </main>

    <Footer />

    {/* Non-Blocking Community Link Click Telemetry (0ms Latency for Users) */}
    <script is:inline>
      (function() {
        function findAnchor(node) {
          var el = node;
          while (el && el !== document && el !== document.documentElement) {
            if (el.tagName && el.tagName.toUpperCase() === 'A') return el;
            el = el.parentElement || el.parentNode;
          }
          return null;
        }

        document.addEventListener('click', function(e) {
          try {
            var target = e.target;
            if (!target) return;
            var link = findAnchor(target);
            if (!link) return;

            var rawHref = link.getAttribute('href') || link.href || '';
            var href = rawHref.toLowerCase();
            var communityAttr = (link.getAttribute('data-community') || '').toLowerCase();
            var channel = null;

            if (communityAttr === 'whatsapp' || href.indexOf('whatsapp.com') !== -1 || href.indexOf('wa.me') !== -1) {
              channel = 'whatsapp';
            } else if (communityAttr === 'telegram' || href.indexOf('t.me') !== -1 || href.indexOf('telegram.me') !== -1) {
              channel = 'telegram';
            }
            if (!channel) return;

            // Accurate placement surface detection
            var placement = link.getAttribute('data-track-cta');
            if (!placement) {
              if (link.closest('header')) {
                placement = 'header';
              } else if (link.closest('footer')) {
                placement = 'footer';
              } else if (window.location.pathname.indexOf('/exams/') !== -1) {
                placement = 'exam_detail';
              } else if (window.location.pathname === '/' || window.location.pathname === '') {
                placement = 'homepage';
              } else {
                placement = 'tools_content';
              }
            }

            var storageKey = 'it_community_click_stats_v1';
            var userKey = 'it_user_joined_' + channel;
            var isUnique = !localStorage.getItem(userKey);
            if (isUnique) {
              localStorage.setItem(userKey, String(Date.now()));
            }

            // Local cache update for instant Admin Dash reflection
            try {
              var raw = localStorage.getItem(storageKey);
              var stats = raw ? JSON.parse(raw) : {
                whatsapp: { totalClicks: 0, uniqueUsers: 0, placements: {} },
                telegram: { totalClicks: 0, uniqueUsers: 0, placements: {} },
                daily: [],
                recentClicks: []
              };
              if (!stats[channel]) stats[channel] = { totalClicks: 0, uniqueUsers: 0, placements: {} };
              stats[channel].totalClicks = (stats[channel].totalClicks || 0) + 1;
              if (isUnique) {
                stats[channel].uniqueUsers = (stats[channel].uniqueUsers || 0) + 1;
              }
              if (!stats[channel].placements) stats[channel].placements = {};
              stats[channel].placements[placement] = (stats[channel].placements[placement] || 0) + 1;

              var today = new Date().toISOString().split('T')[0];
              if (!Array.isArray(stats.daily)) stats.daily = [];
              var dayObj = null;
              for (var i = 0; i < stats.daily.length; i++) {
                if (stats.daily[i].date === today) { dayObj = stats.daily[i]; break; }
              }
              if (!dayObj) {
                dayObj = { date: today, whatsapp: 0, telegram: 0, uniqueUsers: 0 };
                stats.daily.push(dayObj);
              }
              dayObj[channel] = (dayObj[channel] || 0) + 1;
              if (isUnique) dayObj.uniqueUsers = (dayObj.uniqueUsers || 0) + 1;

              if (!Array.isArray(stats.recentClicks)) stats.recentClicks = [];
              stats.recentClicks.unshift({
                id: 'clk_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
                channel: channel,
                placement: placement,
                page: window.location.pathname,
                timestamp: new Date().toISOString(),
                isUnique: isUnique
              });
              if (stats.recentClicks.length > 50) stats.recentClicks.pop();

              localStorage.setItem(storageKey, JSON.stringify(stats));
              window.dispatchEvent(new CustomEvent('it:community_click', { detail: { channel: channel, placement: placement, isUnique: isUnique } }));
            } catch (storageErr) {}

            // Send non-blocking beacon to Cloudflare Pages edge function
            var payload = JSON.stringify({
              channel: channel,
              placement: placement,
              page: window.location.pathname,
              isUnique: isUnique,
              timestamp: new Date().toISOString()
            });
            if (navigator.sendBeacon) {
              navigator.sendBeacon('/api/track-click', payload);
            } else {
              fetch('/api/track-click', { method: 'POST', body: payload, keepalive: true }).catch(function(){});
            }

            // Google Analytics 4 Event
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'join_community_click', {
                channel: channel,
                placement: placement,
                is_unique: isUnique
              });
            }

            // Microsoft Clarity Event
            if (typeof window.clarity === 'function') {
              window.clarity('event', 'join_' + channel);
            }
          } catch (err) {}
        }, true);
      })();
    </script>
  </body>
</html>
