---
import { siteConfig } from '../config/site';
---

<footer class="mt-20 relative overflow-hidden" style="border-top: 1px solid var(--border-ghost); background: var(--bg-surface);">
  <!-- Subtle gradient top accent -->
  <div class="absolute top-0 left-0 right-0 h-px"
       style="background: linear-gradient(90deg, transparent 0%, var(--brand-indigo-bright) 30%, var(--brand-cyan) 60%, transparent 100%); opacity: 0.4;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-10">
      <!-- Col 1: Brand -->
      <div class="md:col-span-1 space-y-4">
        <!-- Logo row -->
        <a href="/" class="flex items-center gap-2.5 group w-fit">
          <img
            src="/logo-192.png"
            alt="IndianTimers Logo"
            width="32"
            height="32"
            class="w-8 h-8 rounded-xl object-contain shadow-xs group-hover:scale-105 transition-transform"
          />
          <span class="font-display font-bold text-[15px] text-slate-900 dark:text-white">{siteConfig.name}</span>
        </a>
        <p class="text-[12px] leading-relaxed" style="color: var(--text-muted);">
          {siteConfig.tagline}. Dedicated to verified schedule provenance and student focus tools.
        </p>
        <p class="text-[11px]" style="color: var(--text-ghost);">
          Last verified against official circulars: October 2026
        </p>
        <!-- India flag badge -->
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold"
             style="background: var(--bg-subtle); color: var(--text-secondary); border: 1px solid var(--border-subtle);">
          🇮🇳 Made for Indian Students
        </div>

        <!-- Official Community Channels -->
        <div class="space-y-1.5 pt-1">
          <div class="text-[10px] font-black uppercase tracking-wider" style="color: var(--text-muted);">
            Daily Alerts Channels
          </div>
          <div class="flex items-center gap-2">
            <a
              href={siteConfig.links.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              data-community="whatsapp"
              data-track-cta="footer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-[11px] font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-all shadow-xs hover:scale-105"
            >
              <span>WhatsApp</span>
              <span>→</span>
            </a>
            <a
              href={siteConfig.links.telegram}
              target="_blank"
              rel="noopener noreferrer"
              data-community="telegram"
              data-track-cta="footer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-[11px] font-bold text-white bg-[#0088cc] hover:bg-[#0077b5] transition-all shadow-xs hover:scale-105"
            >
              <span>Telegram</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Exam Hubs -->
      <div>
        <h4 class="text-[11px] font-black uppercase tracking-widest mb-4" style="color: var(--text-hero);">Exam Hubs</h4>
        <ul class="space-y-2.5">
          {siteConfig.categories.slice(0, 5).map((cat) => (
            <li>
              <a href={`/exams/${cat.slug}/`}
                 class="text-[12px] font-medium transition-all hover:translate-x-0.5 inline-block"
                 style="color: var(--text-muted);">
                {cat.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/calendar/2027/" class="text-[12px] font-bold inline-flex items-center gap-1"
               style="color: var(--accent-text);">
              2027 Master Calendar →
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Tools -->
      <div>
        <h4 class="text-[11px] font-black uppercase tracking-widest mb-4" style="color: var(--text-hero);">Student Tools</h4>
        <ul class="space-y-2.5">
          {[
            { href: '/tools/marks-vs-percentile/', label: 'Marks vs Percentile & Rank' },
            { href: '/tools/age-eligibility-calculator/', label: 'Age & Attempt Limit Checker' },
            { href: '/tools/pomodoro-timer/', label: 'Pomodoro Focus Timer' },
            { href: '/tools/mock-test-timer/', label: 'Mock Test Simulator' },
            { href: '/tools/stopwatch/', label: 'Precision Stopwatch' },
            { href: '/tools/countdown/', label: 'Custom Countdown Creator' },
            { href: '/dashboard/', label: 'Personal Dashboard' },
          ].map((item) => (
            <li>
              <a href={item.href}
                 class="text-[12px] font-medium transition-all hover:translate-x-0.5 inline-block"
                 style="color: var(--text-muted);">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Trust -->
      <div>
        <h4 class="text-[11px] font-black uppercase tracking-widest mb-4" style="color: var(--text-hero);">Trust & Standards</h4>
        <ul class="space-y-2.5">
          {[
            { href: '/editorial-policy/', label: 'Editorial Verification Policy' },
            { href: '/about/', label: 'About IndianTimers' },
            { href: '/contact/', label: 'Contact & Report Change' },
            { href: '/privacy-policy/', label: 'Privacy Policy' },
            { href: '/terms/', label: 'Terms & Disclaimer' },
          ].map((item) => (
            <li>
              <a href={item.href}
                 class="text-[12px] font-medium transition-all hover:translate-x-0.5 inline-block"
                 style="color: var(--text-muted);">
                {item.label}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a href={`mailto:${siteConfig.contactEmail}`}
               class="text-[11px] font-medium transition-all hover:underline inline-flex items-center gap-1"
               style="color: var(--accent-text);">
              <span>✉</span> {siteConfig.contactEmail}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="pt-6" style="border-top: 1px solid var(--border-ghost);">
      <p class="text-[11px] leading-relaxed mb-4" style="color: var(--text-ghost);">
        <strong style="color: var(--text-muted);">Official Disclaimer:</strong> IndianTimers is an independent student utility and information portal. We are not affiliated with, endorsed by, or representing any government body, including NTA, UPSC, CBSE, or any conducting authority. While schedules are verified against official notices, candidates must verify all critical deadlines with official portals.
      </p>
      <div class="flex flex-wrap items-center justify-between gap-3 text-[11px]" style="color: var(--text-ghost);">
        <div>
          <span>© {new Date().getFullYear()} {siteConfig.name}. Designed for Indian students.</span>
          <span class="mx-2">·</span>
          <a
            href="https://icons8.com"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:underline transition-colors"
            style="color: var(--text-muted);"
          >
            Test Icon By Icons8
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
