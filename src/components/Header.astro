---
import { siteConfig } from '../config/site';
import ThemeToggle from './ThemeToggle';
---

<header class="sticky top-0 z-50 w-full" id="site-header">
  <!-- Backdrop blur layer -->
  <div class="absolute inset-0 bg-white/85 dark:bg-[#171923]/90 backdrop-blur-xl border-b border-black/[0.06] dark:border-white/[0.08] transition-all duration-300" id="header-bg"></div>

  <div class="relative max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-[64px] flex items-center justify-between gap-2 sm:gap-4">
    {/* Brand mark */}
    <a href="/" class="flex items-center gap-2 group shrink-0" aria-label="IndianTimers — Home">
      <!-- Official Logomark -->
      <img
        src="/logo-192.png"
        alt="IndianTimers Logo"
        width="36"
        height="36"
        class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl object-contain shadow-xs group-hover:scale-105 transition-transform duration-200 shrink-0"
      />
      <div class="flex flex-col leading-none">
        <span class="font-display font-bold text-[15px] sm:text-[16px] tracking-tight text-[var(--text-hero)] whitespace-nowrap">{siteConfig.name}</span>
        <span class="text-[9px] sm:text-[10px] font-bold text-[var(--text-muted)] tracking-wider uppercase mt-0.5 truncate hidden xs:block">Exam Timers · India</span>
      </div>
    </a>

    {/* Desktop nav */}
    <nav class="hidden md:flex items-center gap-1 sm:gap-1.5 shrink-0" aria-label="Main Navigation">
      {/* High-engagement primary navigation links */}
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          class="relative px-3 py-1.5 rounded-full text-[13px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all duration-150 flex items-center gap-1.5 whitespace-nowrap shrink-0 group"
        >
          <span class="whitespace-nowrap">{item.name}</span>
          {item.badge && (
            <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-[#D4FF4F] text-[#111406] shadow-xs whitespace-nowrap">
              {item.badge}
            </span>
          )}
        </a>
      ))}

      {/* Tools & More Mega Hover Dropdown */}
      <div class="relative group" id="tools-dropdown-wrapper">
        <button
          type="button"
          id="tools-dropdown-btn"
          class="relative px-3 py-1.5 rounded-full text-[13px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all duration-150 flex items-center gap-1 cursor-pointer focus:outline-none whitespace-nowrap shrink-0"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span class="whitespace-nowrap">Tools & More</span>
          <svg
            class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--text-hero)] transition-transform duration-200 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            id="dropdown-chevron"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        {/* Floating Mega Dropdown Panel */}
        <div
          id="tools-dropdown-panel"
          class="absolute top-full -right-16 sm:-right-8 lg:left-1/2 lg:-translate-x-1/2 pt-2 w-[700px] max-w-[calc(100vw-24px)] pointer-events-none opacity-0 invisible transition-all duration-200 ease-out z-50"
        >
          <div class="bg-white/95 dark:bg-[#161822]/95 backdrop-blur-2xl rounded-2xl border border-black/[0.08] dark:border-white/[0.1] shadow-2xl p-5 ring-1 ring-black/5">
            <div class="grid grid-cols-12 gap-5">
              
              {/* Left Column: Interactive Study Suite & Embeds (7 cols) */}
              <div class="col-span-7 space-y-2">
                <div class="flex items-center justify-between pb-1 border-b border-black/[0.04] dark:border-white/[0.06]">
                  <span class="text-[10px] font-black uppercase tracking-wider text-[var(--text-muted)]">
                    Interactive Study Suite
                  </span>
                  <span class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400">
                    100% Free · No Login
                  </span>
                </div>

                {/* FEATURED: Marks vs Percentile & Rank Predictor */}
                <a
                  href="/tools/marks-vs-percentile/"
                  class="group/item flex items-start gap-3 p-3 rounded-xl bg-gradient-to-r from-indigo-500/15 via-[#D4FF4F]/10 to-transparent border border-indigo-500/30 dark:border-indigo-500/40 hover:border-indigo-500 hover:shadow-md transition-all duration-150"
                  id="nav-link-marks-percentile"
                >
                  <div class="w-8 h-8 rounded-lg bg-indigo-600 dark:bg-indigo-500 text-white flex items-center justify-center shrink-0 font-bold text-[14px] group-hover/item:scale-105 transition-transform shadow-xs">
                    📊
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5">
                      <span class="text-[13px] font-bold text-[var(--text-hero)] group-hover/item:text-indigo-600 dark:group-hover/item:text-indigo-400">
                        Marks vs Percentile &amp; Rank
                      </span>
                      <span class="px-1.5 py-0.5 rounded text-[9px] font-black bg-[#D4FF4F] text-[#111406]">
                        NEW
                      </span>
                    </div>
                    <p class="text-[11px] text-[var(--text-secondary)] leading-snug mt-0.5">
                      Instant AIR, NTA percentile &amp; college predictor for JEE Main &amp; NEET mock scores.
                    </p>
                  </div>
                </a>

                {/* College Predictor 2027 */}
                <a
                  href="/tools/college-predictor/"
                  class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-[var(--bg-subtle)] transition-all duration-150"
                  id="nav-link-college-predictor"
                >
                  <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0 text-[13px] group-hover/item:scale-105 transition-transform font-bold">
                    🏛️
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5">
                      <span class="text-[12px] font-bold text-[var(--text-hero)] group-hover/item:text-indigo-600 dark:group-hover/item:text-indigo-400">
                        College Predictor 2027
                      </span>
                      <span class="px-1 py-0.2 rounded text-[8px] font-black bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                        JoSAA/MCC
                      </span>
                    </div>
                    <p class="text-[11px] text-[var(--text-secondary)] leading-snug">
                      Category-wise NIT, IIIT, AIIMS &amp; State GMC cutoffs.
                    </p>
                  </div>
                </a>

                {/* Age & Attempt Limit Calculator */}
                <a
                  href="/tools/age-eligibility-calculator/"
                  class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-[var(--bg-subtle)] transition-all duration-150"
                >
                  <div class="w-7 h-7 rounded-lg bg-[var(--bg-subtle)] text-[var(--text-hero)] flex items-center justify-center shrink-0 text-[13px] group-hover/item:scale-105 transition-transform">
                    🎯
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[12px] font-semibold text-[var(--text-hero)]">
                      Age &amp; Attempt Limit Checker
                    </div>
                    <p class="text-[11px] text-[var(--text-muted)] leading-tight">
                      Official age criteria, cut-off dates &amp; remaining attempts for NEET, JEE &amp; UPSC.
                    </p>
                  </div>
                </a>

                {/* Custom Countdown Creator */}
                <a
                  href="/tools/countdown/"
                  class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-[var(--bg-subtle)] transition-all duration-150"
                >
                  <div class="w-7 h-7 rounded-lg bg-[var(--bg-subtle)] text-[var(--text-hero)] flex items-center justify-center shrink-0 text-[13px] group-hover/item:scale-105 transition-transform">
                    ⏱️
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[12px] font-semibold text-[var(--text-hero)]">
                      Create Custom Countdown
                    </div>
                    <p class="text-[11px] text-[var(--text-muted)] leading-tight">
                      Personal target timer for test series, revision deadlines &amp; private goals.
                    </p>
                  </div>
                </a>

                {/* Pomodoro Focus Timer */}
                <a
                  href="/tools/pomodoro-timer/"
                  class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-[var(--bg-subtle)] transition-all duration-150"
                >
                  <div class="w-7 h-7 rounded-lg bg-[var(--bg-subtle)] text-[var(--text-hero)] flex items-center justify-center shrink-0 text-[13px] group-hover/item:scale-105 transition-transform">
                    🍅
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[12px] font-semibold text-[var(--text-hero)]">
                      Pomodoro Focus Timer
                    </div>
                    <p class="text-[11px] text-[var(--text-muted)] leading-tight">
                      25-minute deep focus intervals with scientific sound alarms & break cycles.
                    </p>
                  </div>
                </a>

                {/* Precision Stopwatch */}
                <a
                  href="/tools/stopwatch/"
                  class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-[var(--bg-subtle)] transition-all duration-150"
                >
                  <div class="w-7 h-7 rounded-lg bg-[var(--bg-subtle)] text-[var(--text-hero)] flex items-center justify-center shrink-0 text-[13px] group-hover/item:scale-105 transition-transform">
                    ⚡
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[12px] font-semibold text-[var(--text-hero)]">
                      Precision Stopwatch & Laps
                    </div>
                    <p class="text-[11px] text-[var(--text-muted)] leading-tight">
                      Split-second millisecond timer with lap pacing for question speed solving.
                    </p>
                  </div>
                </a>

                {/* Study Session Timer */}
                <a
                  href="/tools/study-timer/"
                  class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-[var(--bg-subtle)] transition-all duration-150"
                >
                  <div class="w-7 h-7 rounded-lg bg-[var(--bg-subtle)] text-[var(--text-hero)] flex items-center justify-center shrink-0 text-[13px] group-hover/item:scale-105 transition-transform">
                    📖
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[12px] font-semibold text-[var(--text-hero)]">
                      Study Session Timer
                    </div>
                    <p class="text-[11px] text-[var(--text-muted)] leading-tight">
                      Track daily study hours with goal milestones and progress rings.
                    </p>
                  </div>
                </a>
              </div>

              {/* Right Column: Exam Streams & Resources (5 cols) */}
              <div class="col-span-5 pl-4 border-l border-black/[0.06] dark:border-white/[0.08] flex flex-col justify-between">
                <div>
                  <div class="pb-1 border-b border-black/[0.04] dark:border-white/[0.06] mb-2.5">
                    <span class="text-[10px] font-black uppercase tracking-wider text-[var(--text-muted)]">
                      Browse by Stream
                    </span>
                  </div>

                  <div class="grid grid-cols-2 gap-1.5">
                    <a
                      href="/exams/engineering/"
                      class="px-2 py-1.5 rounded-lg text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all flex items-center gap-1.5"
                    >
                      <img src="/icons/categories/engineering.png" alt="Engineering" class="w-3.5 h-3.5 object-contain inline-block" />
                      <span>Engineering</span>
                    </a>
                    <a
                      href="/exams/medical/"
                      class="px-2 py-1.5 rounded-lg text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all flex items-center gap-1.5"
                    >
                      <img src="/icons/categories/medical.png" alt="Medical" class="w-3.5 h-3.5 object-contain inline-block" />
                      <span>Medical</span>
                    </a>
                    <a
                      href="/exams/government/"
                      class="px-2 py-1.5 rounded-lg text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all flex items-center gap-1.5"
                    >
                      <img src="/icons/categories/government.png" alt="Govt & UPSC" class="w-3.5 h-3.5 object-contain inline-block" />
                      <span>Govt & UPSC</span>
                    </a>
                    <a
                      href="/exams/law/"
                      class="px-2 py-1.5 rounded-lg text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all flex items-center gap-1.5"
                    >
                      <img src="/icons/categories/law.png" alt="Law" class="w-3.5 h-3.5 object-contain inline-block" />
                      <span>Law (CLAT)</span>
                    </a>
                    <a
                      href="/exams/board-exams/"
                      class="px-2 py-1.5 rounded-lg text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all flex items-center gap-1.5"
                    >
                      <img src="/icons/categories/board-exams.png" alt="Board Exams" class="w-3.5 h-3.5 object-contain inline-block" />
                      <span>Board Exams</span>
                    </a>
                    <a
                      href="/exams/management/"
                      class="px-2 py-1.5 rounded-lg text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all flex items-center gap-1.5"
                    >
                      <img src="/icons/categories/management.png" alt="Management" class="w-3.5 h-3.5 object-contain inline-block" />
                      <span>Management</span>
                    </a>
                    <a
                      href="/exams/other-entrance-exams/"
                      class="px-2 py-1.5 rounded-lg text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all flex items-center gap-1.5"
                    >
                      <img src="/icons/categories/other-entrance-exams.png" alt="Other Entrances" class="w-3.5 h-3.5 object-contain inline-block" />
                      <span>Other Entrances</span>
                    </a>
                  </div>
                </div>

                <div class="pt-3 mt-3 border-t border-black/[0.04] dark:border-white/[0.06] space-y-1">
                  <div class="text-[10px] font-black uppercase tracking-wider text-[var(--text-muted)] mb-1">
                    Guides & Information
                  </div>
                  <a
                    href="/blog/"
                    class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-[11px] font-bold text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all group"
                  >
                    <span class="flex items-center gap-1.5">
                      <span>📰</span>
                      <span>Exam Guides & News Blog</span>
                    </span>
                    <span class="px-1.5 py-0.2 rounded text-[8px] font-black bg-[#D4FF4F] text-[#111406]">
                      NEW
                    </span>
                  </a>
                  <a
                    href="/editorial-policy/"
                    class="block px-2 py-1 rounded-lg text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all"
                  >
                    🛡️ Official Verification & Editorial Policy
                  </a>
                  <a
                    href="/support/"
                    class="block px-2 py-1 rounded-lg text-[11px] font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-all"
                  >
                    💖 Support IndianTimers Initiative
                  </a>
                  <a
                    href="/about/"
                    class="block px-2 py-1 rounded-lg text-[11px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all"
                  >
                    ℹ️ About IndianTimers
                  </a>
                </div>
              </div>

            </div>

            {/* Bottom Strip */}
            <div class="mt-3.5 pt-2.5 border-t border-black/[0.06] dark:border-white/[0.08] flex items-center justify-between text-[11px]">
              <div class="flex items-center gap-2.5">
                <span class="text-[var(--text-muted)] flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span>Fast & Accurate · Verified Schedules</span>
                </span>
                <span class="text-black/20 dark:text-white/20">|</span>
                <a
                  href={siteConfig.links.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-community="whatsapp"
                  data-track-cta="dropdown_bottom"
                  class="text-emerald-600 dark:text-emerald-400 hover:underline font-semibold"
                >
                  WhatsApp
                </a>
                <span class="text-black/20 dark:text-white/20">·</span>
                <a
                  href={siteConfig.links.telegram}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-community="telegram"
                  data-track-cta="dropdown_bottom"
                  class="text-[#0088cc] dark:text-[#38bdf8] hover:underline font-semibold"
                >
                  Telegram
                </a>
              </div>
              <a
                href="/my-exams/"
                class="font-bold text-[var(--text-hero)] hover:text-emerald-600 dark:hover:text-[#D4FF4F] flex items-center gap-1 transition-colors"
              >
                <span>Open Personal Cockpit</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    {/* Right controls: Clean, essential desktop actions */}
    <div class="flex items-center gap-2 shrink-0">
      <a
        href="/support/"
        class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[12px] font-bold text-rose-600 dark:text-rose-400 bg-rose-50/90 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200/80 dark:border-rose-900/80 transition-all shadow-2xs whitespace-nowrap shrink-0"
        aria-label="Support IndianTimers Student Initiative"
      >
        <span>💖</span>
        <span class="whitespace-nowrap">Support Us</span>
      </a>

      <a
        href="/tools/countdown/"
        class="hidden sm:inline-flex items-center gap-1.5 bg-[#18181B] dark:bg-white text-white dark:text-[#111406] hover:bg-black dark:hover:bg-slate-100 font-semibold text-[12px] py-2 px-3.5 rounded-full shadow-xs transition-all duration-150 hover:-translate-y-0.5 whitespace-nowrap shrink-0"
        aria-label="Create custom countdown timer"
      >
        <span class="w-3.5 h-3.5 rounded-full bg-[#D4FF4F] text-[#111406] flex items-center justify-center font-black text-[11px] leading-none shrink-0">
          +
        </span>
        <span class="whitespace-nowrap">Custom Timer</span>
      </a>

      <ThemeToggle client:load />

      {/* Mobile menu button */}
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden w-9 h-9 flex items-center justify-center rounded-full text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all shrink-0"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile menu drawer */}
  <div
    id="mobile-menu"
    class="hidden md:hidden relative border-t border-[var(--border-subtle)] bg-[var(--bg-glass-strong)] backdrop-blur-2xl px-4 pb-6 pt-3 space-y-3 max-h-[85vh] overflow-y-auto"
  >
    {/* Mobile Support Us Highlight Card */}
    <div class="px-1 pb-1">
      <a
        href="/support/"
        class="flex items-center justify-between p-3 rounded-2xl bg-gradient-to-r from-rose-50 to-pink-50/50 dark:from-rose-950/40 dark:to-pink-950/20 border border-rose-200/80 dark:border-rose-900/60 text-slate-900 dark:text-white group hover:shadow-xs transition-all"
      >
        <div class="flex items-center gap-2.5">
          <span class="w-8 h-8 rounded-xl bg-rose-100 dark:bg-rose-900/60 text-rose-600 dark:text-rose-300 flex items-center justify-center text-sm shadow-2xs">
            💖
          </span>
          <div>
            <div class="text-[13px] font-bold text-rose-950 dark:text-rose-200 flex items-center gap-1.5">
              <span>Support IndianTimers</span>
              <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-rose-200/70 dark:bg-rose-800 text-rose-800 dark:text-rose-200">Solo Student</span>
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">UPI · Leaderboard · Wall of Fame</div>
          </div>
        </div>
        <span class="text-rose-500 font-bold text-xs group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>

    {/* Primary high-engagement links */}
    <div class="space-y-1">
      <div class="px-2 text-[10px] font-black uppercase tracking-wider text-[var(--text-muted)]">
        Main Navigation
      </div>
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-[14px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all"
        >
          <span>{item.name}</span>
          {item.badge && (
            <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-[#D4FF4F] text-[#111406]">
              {item.badge}
            </span>
          )}
        </a>
      ))}
    </div>

    {/* Study Tools & Embeds Section */}
    <div class="pt-2 border-t border-black/[0.06] dark:border-white/[0.08] space-y-1">
      <div class="px-2 text-[10px] font-black uppercase tracking-wider text-[var(--text-muted)]">
        Interactive Tools & Widgets
      </div>
      
      {/* Highlighted New Tool: Marks vs Percentile */}
      <a
        href="/tools/marks-vs-percentile/"
        class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500/20 via-[#D4FF4F]/15 to-transparent border border-indigo-500/40 text-[13px] font-bold text-[var(--text-hero)]"
      >
        <span class="flex items-center gap-2">
          <span>📊</span>
          <span>Marks vs Percentile &amp; Rank</span>
        </span>
        <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-[#D4FF4F] text-[#111406]">
          NEW
        </span>
      </a>

      {/* College Predictor 2027 */}
      <a
        href="/tools/college-predictor/"
        class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-indigo-50/60 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800/60 text-[13px] font-bold text-[var(--text-hero)]"
      >
        <span class="flex items-center gap-2">
          <span>🏛️</span>
          <span>College Predictor 2027</span>
        </span>
