---
import { siteConfig } from '../config/site';
import ThemeToggle from './ThemeToggle';
---

<header class="sticky top-0 z-50 w-full" id="site-header">
  <!-- Backdrop blur layer -->
  <div class="absolute inset-0 bg-white/85 dark:bg-[#171923]/90 backdrop-blur-xl border-b border-black/[0.06] dark:border-white/[0.08] transition-all duration-300" id="header-bg"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[64px] flex items-center justify-between gap-4">
    {/* Brand mark */}
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="IndianTimers — Home">
      <!-- Logomark: dark pill badge with lime clock icon -->
      <!-- Official Logomark -->
      <img
        src="/logo-192.png"
        alt="IndianTimers Logo"
        width="36"
        height="36"
        class="w-9 h-9 rounded-xl object-contain shadow-xs group-hover:scale-105 transition-transform duration-200"
      />
      <div class="flex flex-col leading-none">
        <span class="font-display font-bold text-[16px] tracking-tight text-[var(--text-hero)]">{siteConfig.name}</span>
        <span class="text-[10px] font-bold text-[var(--text-muted)] tracking-wider uppercase mt-0.5">Exam Timers · India</span>
      </div>
    </a>

    {/* Desktop nav */}
    <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          class="relative px-3.5 py-1.5 rounded-full text-[13px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all duration-150 flex items-center gap-1.5 group"
        >
          <span>{item.name}</span>
          {item.badge && (
            <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-[#D4FF4F] text-[#111406] shadow-xs">
              {item.badge}
            </span>
          )}
        </a>
      ))}
    </nav>

    {/* Right controls */}
    <div class="flex items-center gap-2.5">
      <a
        href="/tools/countdown/"
        class="hidden sm:inline-flex items-center gap-1.5 bg-[#18181B] dark:bg-white text-white dark:text-[#111406] hover:bg-black dark:hover:bg-slate-100 font-semibold text-[12px] py-2 px-4 rounded-full shadow-xs transition-all duration-150 hover:-translate-y-0.5"
        aria-label="Create custom countdown timer"
      >
        <span class="w-3.5 h-3.5 rounded-full bg-[#D4FF4F] text-[#111406] flex items-center justify-center font-black text-[11px] leading-none">
          +
        </span>
        <span>Custom Timer</span>
      </a>

      <ThemeToggle client:load />

      {/* Mobile menu button */}
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden w-9 h-9 flex items-center justify-center rounded-full text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile menu drawer */}
  <div
    id="mobile-menu"
    class="hidden md:hidden relative border-t border-[var(--border-subtle)] bg-[var(--bg-glass-strong)] backdrop-blur-xl px-4 pb-4 pt-2 space-y-1"
  >
    {siteConfig.navigation.map((item) => (
      <a
        href={item.href}
        class="flex items-center justify-between px-3.5 py-2.5 rounded-full text-[14px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-hero)] hover:bg-[var(--bg-subtle)] transition-all"
      >
        <span>{item.name}</span>
        {item.badge && (
          <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-[#D4FF4F] text-[#111406]">
            {item.badge}
          </span>
        )}
      </a>
    ))}
    <div class="pt-2 pb-1">
      <a href="/tools/countdown/" class="btn-primary w-full justify-center text-[13px] py-2.5">
        + Create Custom Countdown
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      hamburger?.classList.toggle('hidden', !isOpen);
      closeIcon?.classList.toggle('hidden', isOpen);
    });
  }

  // Enhance header shadow on scroll
  const headerBg = document.getElementById('header-bg');
  window.addEventListener('scroll', () => {
    if (headerBg) {
      if (window.scrollY > 8) {
        headerBg.style.boxShadow = '0 4px 20px -2px rgba(15, 23, 42, 0.08)';
      } else {
        headerBg.style.boxShadow = 'none';
      }
    }
  }, { passive: true });
</script>
