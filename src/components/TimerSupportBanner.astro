---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-[#171923] border border-rose-200/70 dark:border-rose-900/40 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3 text-slate-800 dark:text-slate-200 ${className}`}>
  <div class="flex items-center gap-2.5 text-center sm:text-left">
    <span class="w-8 h-8 rounded-xl bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-300 flex items-center justify-center shrink-0 text-sm shadow-2xs">
      💖
    </span>
    <div>
      <p class="text-xs font-bold text-slate-900 dark:text-white">
        Built by a solo student for Indian aspirants
      </p>
      <p class="text-[11px] text-slate-500 dark:text-slate-400">
        If these timers help your study routine, voluntary UPI support helps keep our servers running.
      </p>
    </div>
  </div>
  <a
    href="/support/"
    class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold text-rose-700 dark:text-rose-300 bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/60 dark:hover:bg-rose-900/60 border border-rose-200 dark:border-rose-900/80 transition-all flex items-center gap-1 shadow-2xs"
  >
    <span>Support Us</span>
    <span>→</span>
  </a>
</div>
